{
  "name": "yublog",
  "version": "1.1.0",
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "astro": "astro",
    "sync": "astro sync",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build --force",
    "preview": "astro preview",
    "test": "node --test",
    "test:blog-browser": "node --test test/blog-browser.test.mjs",
    "test:built-restructure": "node --test scripts/verify-blog-restructure.mjs",
    "test:built-pagination": "node --test scripts/verify-blog-pagination.mjs",
    "test:built-markdown": "node --test scripts/verify-markdown-pipeline.mjs",
    "test:rss-feed": "node --test test/rss-feed.test.mjs",
    "test:blog-tags": "node --test test/blog-tag-filter.test.mjs",
    "test:blog-stats": "node --test test/blog-stats.test.mjs",
    "test:progress-stats": "node --test test/progress-stats.test.mjs",
    "test:recent-post-date": "node --test test/recent-post-date.test.mjs",
    "test:cjk-emphasis": "node --test test/cjk-emphasis.test.mjs",
    "test:toc-active": "node --test test/toc-active.test.mjs",
    "test:canvas-size": "node --test test/canvas-size.test.mjs",
    "test:reduced-motion": "node --test test/reduced-motion.test.mjs",
    "test:sliding-indicator": "node --test test/sliding-indicator.test.mjs",
    "og:cover": "node ./scripts/gen-og-cover.mjs",
    "format": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown --cache",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "eslint . --fix --cache",
    "toolbar:on": "astro preferences enable devToolbar",
    "toolbar:off": "astro preferences disable devToolbar",
    "postbuild": "pagefind --site dist --exclude-selectors \"pre\" --include-characters \"<>\" && node ./scripts/postbuild.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.6.0",
    "@eslint/js": "^10.0.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.0",
    "@expressive-code/plugin-line-numbers": "^0.44.0",
    "@iconify/json": "^2.2.534",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.0",
    "@types/subset-font": "^2.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@unocss/astro": "66.10.5",
    "@unocss/reset": "66.10.5",
    "astro": "^7.3.5",
    "astro-expressive-code": "^0.44.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-xml-parser": "^5.11.1",
    "globals": "^17.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.16.45",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "^2.1.2",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-directive": "^4.0.0",
    "remark-directive-sugar": "^2.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.0",
    "subset-font": "^2.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "unist-util-visit": "^5.1.0",
    "unocss": "66.10.5",
    "vfile": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
