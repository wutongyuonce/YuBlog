---
import { withBasePath } from '~/utils/path'

interface Props {
  title?: string
  subtitle?: string
  isCentered?: boolean
  isArticle?: boolean
  hasHeroImage?: boolean
  isSearchable?: boolean
  searchFilter?: string
  class?: string
}

const {
  title,
  subtitle,
  isCentered = false,
  isArticle = false,
  hasHeroImage = false,
  isSearchable,
  searchFilter,
  class: className,
} = Astro.props

const blogsHref = withBasePath('/blogs/')
---

<header
  class:list={[
    'page-header prose mx-auto',
    {
      'text-center': isCentered,
      'post-header': isArticle,
    },
  ]}
>
  {isArticle && (
    <post-back-link class="post-back-link-host">
      <span class="post-back-link__spacer" hidden></span>
      <a class="post-back-link" href={blogsHref}>
        ← 返回文稿
      </a>
    </post-back-link>
  )}
  {title && <h1 class="page-title">{title}</h1>}
  {subtitle && !hasHeroImage && (
    <p
      class:list={[
        isArticle ? 'post-subtitle' : 'mt--8!',
        'op-50 italic',
        isArticle && 'post-subtitle--centered',
      ]}
    >
      {subtitle}
    </p>
  )}
  <slot name="head" />
  {hasHeroImage && <slot name="hero" />}
</header>
{Astro.slots.has('article') && (
  <article
    class:list={[
      'slide-enter-content prose markdown-content mx-auto',
      { 'post-content': isArticle },
    ]}
    data-pagefind-body={isSearchable ? '' : undefined}
    data-pagefind-filter={
      isSearchable && searchFilter ? searchFilter : undefined
    }
  >
    <slot name="article" />
  </article>
)}

<style>
  .page-header {
    margin-bottom: 3.5rem;
  }

  .post-header {
    margin-bottom: 1.75rem;
  }

  /* 只让文章标题与副标题居中；封面卡片（hero slot）及草稿提示保持自己的排布。 */
  .post-header .page-title,
  .post-header .post-subtitle {
    text-align: center;
  }

  /* 「← 返回文稿」保持靠左。 */
  .post-header .post-back-link-host {
    text-align: left;
  }

  .post-subtitle--centered {
    margin-inline: auto;
    max-width: 46rem;
  }

  .post-back-link-host {
    display: block;
    margin: 0 0 0.85rem;
  }

  .post-back-link__spacer {
    display: block;
    visibility: hidden;
    pointer-events: none;
  }

  .post-back-link__spacer[hidden] {
    display: none;
  }

  .post-back-link,
  :global(.prose) .post-back-link {
    /* Inline padding tracks the surface; block padding stays stable so
       becoming a floating link cannot shift fragment targets. */
    --post-back-glass: 0;
    position: relative;
    display: inline-block;
    margin: 0;
    padding: 0.2rem calc(0.15rem + 0.7rem * var(--post-back-glass));
    color: inherit;
    font-family: inherit;
    /* Same root-relative 1rem as .prose.post-content paragraphs (not
       --blog-reading-size; that token is the .prose root before post-content
       resets it). Footer links bump to the token on purpose; this link must not. */
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.65;
    border-bottom: 0;
    text-decoration: none;
    text-underline-offset: 0.18em;
    isolation: isolate;
    z-index: 150;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .post-back-link::before {
    content: '';
    position: absolute;
    /* Match MobileTocControl FAB milk glass (rgba 0.9 / blur 14 / soft shadow).
       Always inset 0 — size comes from interpolated padding, not negative inset. */
    inset: 0;
    z-index: -1;
    border-radius: 999px;
    background: rgba(255, 255, 255, calc(0.9 * var(--post-back-glass)));
    box-shadow: 0 2px 10px rgba(0, 0, 0, calc(0.07 * var(--post-back-glass)));
    backdrop-filter: blur(calc(14px * var(--post-back-glass)))
      saturate(calc(1 + 0.15 * var(--post-back-glass)));
    -webkit-backdrop-filter: blur(calc(14px * var(--post-back-glass)))
      saturate(calc(1 + 0.15 * var(--post-back-glass)));
    opacity: 1;
    pointer-events: none;
    transition: none;
  }

  :global(.dark) .post-back-link::before {
    background: rgba(28, 28, 28, calc(0.88 * var(--post-back-glass)));
    box-shadow: 0 2px 12px rgba(0, 0, 0, calc(0.34 * var(--post-back-glass)));
  }

  .post-back-link.is-pinned {
    position: fixed;
    top: var(--post-back-top, 12px);
    left: var(--post-back-left, 1.25rem);
    margin: 0;
    /* Slightly roomier hit target once pinned as a pill. */
    padding: 0.35rem 0.85rem;
  }

  .post-back-link.is-pinned::before {
    inset: 0;
  }

  .post-back-link:is(:hover, :focus-visible),
  :global(.prose) .post-back-link:is(:hover, :focus-visible) {
    color: var(--accent);
    border-bottom: 0;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent);
  }

  .post-back-link.is-pinned:is(:hover, :focus-visible) {
    /* Pill already frames the label; underline reads busy on glass. */
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-back-link::before {
      transition: none;
    }
  }
</style>

<script>
  class PostBackLink extends HTMLElement {
    #link: HTMLAnchorElement | null = null
    #spacer: HTMLElement | null = null
    #pinned = false
    #left = 0
    /** In-flow top at scroll≈0; glass fades by travel from here. */
    #restingNatural = 0
    #frame = 0
    #reduceMotion = false
    #mq: MediaQueryList | null = null
    static #PIN_TOP = 12

    #onScroll = () => {
      this.#scheduleUpdate()
    }

    #onResize = () => {
      this.#update(true)
    }

    #onMotion = () => {
      this.#reduceMotion = !!this.#mq?.matches
      this.#update(true)
    }

    #scheduleUpdate = () => {
      if (this.#frame) return
      this.#frame = requestAnimationFrame(() => {
        this.#frame = 0
        this.#update()
      })
    }

    connectedCallback() {
      this.#link = this.querySelector('.post-back-link')
      this.#spacer = this.querySelector('.post-back-link__spacer')
      if (!this.#link || !this.#spacer) return

      this.#mq = window.matchMedia('(prefers-reduced-motion: reduce)')
      this.#reduceMotion = this.#mq.matches
      this.#mq.addEventListener('change', this.#onMotion)

      window.addEventListener('scroll', this.#onScroll, { passive: true })
      window.addEventListener('resize', this.#onResize)

      this.#update(true)
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.#onScroll)
      window.removeEventListener('resize', this.#onResize)
      this.#mq?.removeEventListener('change', this.#onMotion)
      if (this.#frame) cancelAnimationFrame(this.#frame)
      this.#frame = 0
    }

    #update = (remeasure = false) => {
      const link = this.#link
      const spacer = this.#spacer
      if (!link || !spacer) return

      const pinLine = PostBackLink.#PIN_TOP
      const naturalTop = this.#pinned
        ? spacer.getBoundingClientRect().top
        : link.getBoundingClientRect().top

      // Fade the surface by travel from the page-top position.
      if (!this.#pinned && window.scrollY <= 1) {
        this.#restingNatural = naturalTop
      }

      const shouldPin = naturalTop <= pinLine

      if (shouldPin && !this.#pinned) {
        const rect = link.getBoundingClientRect()
        this.#left = rect.left
        spacer.style.width = `${Math.ceil(rect.width)}px`
        spacer.style.height = `${Math.ceil(rect.height)}px`
        spacer.hidden = false
        link.classList.add('is-pinned')
        this.#pinned = true
      } else if (!shouldPin && this.#pinned) {
        link.classList.remove('is-pinned')
        spacer.hidden = true
        spacer.style.width = ''
        spacer.style.height = ''
        this.#pinned = false
      } else if (this.#pinned && remeasure) {
        link.classList.remove('is-pinned')
        const rect = link.getBoundingClientRect()
        this.#left = rect.left
        spacer.style.width = `${Math.ceil(rect.width)}px`
        spacer.style.height = `${Math.ceil(rect.height)}px`
        link.classList.add('is-pinned')
      }

      // Glass after pin state so unpinning at top does not stick at 1.
      const clearance = Math.max(0, this.#restingNatural - pinLine)
      const morph = Math.min(56, Math.max(1, clearance || 56))
      const travel = this.#restingNatural - naturalTop
      let glass = this.#pinned ? 1 : travel / morph
      glass = Math.min(1, Math.max(0, glass))
      if (this.#reduceMotion) glass = glass >= 0.5 ? 1 : 0

      link.style.setProperty('--post-back-glass', String(glass))
      if (this.#pinned) {
        link.style.setProperty('--post-back-top', `${pinLine}px`)
        link.style.setProperty(
          '--post-back-left',
          `${Math.max(12, this.#left)}px`
        )
      } else {
        link.style.removeProperty('--post-back-top')
        link.style.removeProperty('--post-back-left')
      }
    }
  }

  if (!customElements.get('post-back-link')) {
    customElements.define('post-back-link', PostBackLink)
  }
</script>

<style is:inline>
  .prose.post-header .post-meta {
    margin-top: 1rem !important;
  }

  .prose.post-header .post-meta--with-subtitle {
    margin-top: 0.5rem !important;
  }
</style>
{Astro.slots.has('default') && (
  <div class:list={['mx-auto', className]}>
    <slot />
  </div>
)}
