---
interface Props {
  title?: string
  subtitle?: string
  isCentered?: boolean
  isArticle?: boolean
  hasHeroImage?: boolean
  isSearchable?: boolean
  searchFilter?: string
  class?: string
}

const {
  title,
  subtitle,
  isCentered = false,
  isArticle = false,
  hasHeroImage = false,
  isSearchable,
  searchFilter,
  class: className,
} = Astro.props
---

<header
  class:list={[
    'page-header prose mx-auto',
    {
      'text-center': isCentered,
      'post-header': isArticle,
    },
  ]}
>
  {hasHeroImage ? (
    <slot name="hero" />
  ) : (
    <>
      {title && <h1 class="page-title">{title}</h1>}
      {subtitle && (
        <p class={`${isArticle ? 'post-subtitle' : 'mt--8!'} op-50 italic`}>
          {subtitle}
        </p>
      )}
      <slot name="head" />
    </>
  )}
</header>
{Astro.slots.has('article') && (
  <article
    class:list={[
      'slide-enter-content prose mx-auto',
      { 'post-content': isArticle },
    ]}
    data-pagefind-body={isSearchable ? '' : undefined}
    data-pagefind-filter={
      isSearchable && searchFilter ? searchFilter : undefined
    }
  >
    <slot name="article" />
  </article>
)}

<style>
  .page-header {
    margin-bottom: 3.5rem;
  }

  .post-header {
    margin-bottom: 1.75rem;
  }
</style>

<style is:inline>
  .prose.post-header h1.page-title {
    margin-bottom: 0 !important;
  }

  .prose.post-header .post-subtitle {
    margin-top: 0.95rem !important;
    margin-bottom: 0 !important;
  }

  .prose.post-header .post-meta {
    margin-top: 1rem !important;
  }

  .prose.post-header .post-meta--with-subtitle {
    margin-top: 0.5rem !important;
  }
</style>
{Astro.slots.has('default') && (
  <div class:list={['mx-auto', className]}>
    <slot />
  </div>
)}
