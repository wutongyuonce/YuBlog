---
import Head from '~/components/base/Head.astro'
import CalendarEntry from '~/components/calendar/CalendarEntry.astro'
import ViewSwitch from '~/components/calendar/ViewSwitch.astro'
import PhotoDialog from '~/components/trips/PhotoDialog.astro'
import TripCover from '~/components/trips/TripCover.astro'
import TripDetail from '~/components/trips/TripDetail.astro'
import { AUTHOR_DISPLAY_NAME } from '~/config'
import { entryHash, monthKey, monthPath } from '~/utils/calendar.js'
import {
  getCalendarEntries,
  getTrips,
  getYearColors,
} from '~/utils/trip-entries'
import { MAP_STYLES } from '~/utils/trip-map-settings.js'
import { withBasePath } from '~/utils/path'
import {
  STATUS_LABELS,
  collageImages,
  formatDateRange,
  formatKilometers,
  todayInTripZone,
  tripDayCount,
  tripDistance,
  tripPlaceCount,
  tripStatus,
  tripTotals,
  tripYear,
} from '~/utils/trips.js'

// 全屏旅行页：地图铺满，面板浮在右侧（窄屏在底部）。行为与数据见 docs/design/trips.md。
const trips = await getTrips()
const placedEntries = (await getCalendarEntries()).filter(
  (entry) => entry.data.place
)
const colors = await getYearColors()
const today = todayInTripZone()
const totals = tripTotals(trips.map((trip) => trip.data))
const years = [...new Set(trips.map((trip) => tripYear(trip.data)))]
const groups = years.map((year) => ({
  year,
  trips: trips.filter((trip) => tripYear(trip.data) === year),
}))
const legendYears = [...colors.keys()].toReversed()
const statusOf = (end: string) => tripStatus(end, today)
const outline = (trip: (typeof trips)[number]) =>
  trip.data.days.flatMap((day) =>
    day.stops.flatMap((stop) => stop.route?.path ?? [stop.coordinates])
  )
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head
      title="旅行"
      description="旅行计划与行程记录，在地图上回看每一段路。"
    />
    <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin />
  </head>
  <body class="trips-body">
    <main
      class="trips-page"
      data-trips
      data-map-url={withBasePath('/trips/map.json')}
    >
      <div
        class="trips-canvas"
        data-trips-canvas
        role="region"
        aria-label="旅行地图"
      ></div>
      <p class="trips-message" data-trips-message hidden></p>

      <header class="trips-toolbar">
        <a
          class="trips-home"
          href={withBasePath('/')}
          aria-label="回到博客首页"
        >
          <img
            src={withBasePath('/avatar.webp')}
            width="28"
            height="28"
            alt=""
          />
          <span>{AUTHOR_DISPLAY_NAME}</span>
        </a>
        <div class="trips-toolbar__actions">
          <button
            class="trips-tool"
            type="button"
            data-trips-fit
            aria-label="显示全部旅程"
            title="显示全部旅程"
            disabled
          >
            <span class="i-ri-focus-3-line" aria-hidden="true"></span>
          </button>
          <button
            class="trips-tool"
            type="button"
            data-trips-settings-toggle
            aria-controls="trips-settings"
            aria-expanded="false"
            aria-label="地图设置"
            title="地图设置"
            disabled
          >
            <span class="i-ri-stack-line" aria-hidden="true"></span>
          </button>
          <button
            class="trips-tool"
            type="button"
            data-trips-panel-toggle
            aria-controls="trips-panel"
            aria-expanded="true"
            aria-label="收起旅程面板"
            title="收起旅程面板"
          >
            <span class="i-ri-side-bar-line" aria-hidden="true"></span>
          </button>
          <ViewSwitch current="trips" />
        </div>
      </header>

      <section
        class="trips-settings"
        id="trips-settings"
        data-trips-settings
        aria-labelledby="trips-settings-title"
        hidden
      >
        <header class="trips-settings__header">
          <p>保存在此浏览器</p>
          <h2 id="trips-settings-title">地图设置</h2>
          <button
            class="trips-settings__close"
            type="button"
            data-trips-settings-close
            aria-label="关闭地图设置"
          >
            <span class="i-ri-close-line" aria-hidden="true"></span>
          </button>
        </header>
        <fieldset class="trips-settings__styles">
          <legend>风格</legend>
          {MAP_STYLES.map((style) => (
            <label class="trips-style">
              <input type="radio" name="trips-style" value={style.id} />
              <strong>{style.label}</strong>
              <small>{style.note}</small>
            </label>
          ))}
        </fieldset>
        <label class="trips-switch">
          <span>
            <strong>3D 视角</strong>
            <small>随缩放倾斜，靠近街道时显示立体楼块</small>
          </span>
          <input type="checkbox" role="switch" data-trips-tilt />
        </label>
        <button
          class="trips-settings__reset"
          type="button"
          data-trips-settings-reset
        >
          恢复默认
        </button>
      </section>

      <aside
        class="trips-panel"
        id="trips-panel"
        data-trips-panel
        aria-label="旅程"
      >
        <div class="trips-panel__scroll" data-trips-scroll>
          <div class="trips-overview" id="trips">
            <header class="trips-overview__header">
              <p>
                {totals.count} 段旅程 · {totals.days} 天 · {totals.places}{' '}
                个地点 · 约 {formatKilometers(totals.distance)} 公里
              </p>
              <h1>旅行</h1>
              <p class="trips-overview__source">
                行程数据主要采集自圆周旅迹，并按本站格式整理适配。
              </p>
            </header>
            {trips.length === 0 && <p class="trips-empty">还没有旅程。</p>}
            {groups.map((group) => (
              <section
                aria-labelledby={`trips-year-${group.year}`}
                data-trips-year-group={group.year}
              >
                <h2 class="trips-year" id={`trips-year-${group.year}`}>
                  {group.year}
                </h2>
                <ol class="trips-list">
                  {group.trips.map((trip, index) => {
                    const status = statusOf(trip.data.end)
                    return (
                      <li>
                        <a
                          class="trip-card"
                          href={`#${trip.id}`}
                          data-trip-link={trip.id}
                        >
                          <TripCover
                            images={collageImages(
                              trip.data,
                              (image) => image.src
                            )}
                            title={trip.data.title}
                            outline={outline(trip)}
                            color={colors.get(group.year)!}
                            sizes="(max-width: 48rem) 100vw, 25rem"
                            priority={group.year === years[0] && index === 0}
                          />
                          <span class="trip-card__title">
                            {trip.data.title}
                          </span>
                          <span class="trip-card__dates">
                            <span
                              class="trip-status"
                              data-trip-status={status}
                              data-trip-end={trip.data.end}
                            >
                              {STATUS_LABELS[status]}
                            </span>
                            {formatDateRange(trip.data.start, trip.data.end)}
                          </span>
                          <span class="trip-card__totals">
                            {tripDayCount(trip.data)} 天 ·{' '}
                            {tripPlaceCount(trip.data)} 个地点 · 约{' '}
                            {formatKilometers(tripDistance(trip.data))} 公里
                          </span>
                        </a>
                      </li>
                    )
                  })}
                </ol>
              </section>
            ))}
          </div>
          {trips.map((trip) => {
            const status = statusOf(trip.data.end)
            return (
              <TripDetail
                {trip}
                {status}
                statusLabel={STATUS_LABELS[status]}
                color={colors.get(tripYear(trip.data))!}
              />
            )
          })}
          {placedEntries.map((entry) => (
            <section
              class="trip-detail calendar-detail"
              id={entryHash(entry.id)}
              data-entry-detail={entry.id}
              aria-label={entry.data.title}
            >
              <a class="calendar-detail__back" href="#trips" data-trip-back>
                <span class="i-ri-arrow-left-line" aria-hidden="true" />
                全部旅程
              </a>
              <CalendarEntry {entry} showDate linkPlace={false} />
              <a
                class="calendar-detail__month"
                href={withBasePath(
                  `${monthPath(monthKey(entry.data.date))}#${entry.id}`
                )}
              >
                <span class="i-ri-calendar-line" aria-hidden="true" />
                在日历里查看
              </a>
            </section>
          ))}
        </div>
      </aside>

      {legendYears.length > 0 && (
        <div class="trips-legend" data-trips-legend>
          <ul aria-label="按年份筛选">
            {legendYears.map((year) => (
              <li>
                <button
                  type="button"
                  data-trips-year={year}
                  aria-pressed="false"
                  disabled
                >
                  <span
                    class="trips-legend__dot"
                    style={`--trip-color: ${colors.get(year)}`}
                  />
                  {year}
                </button>
              </li>
            ))}
          </ul>
          <ul class="trips-legend__routes" aria-label="路线样式">
            <li>
              <span class="trips-legend__line" aria-hidden="true" />
              路线
            </li>
            <li>
              <span
                class="trips-legend__line trips-legend__line--flight"
                aria-hidden="true"
              />
              飞机
            </li>
          </ul>
        </div>
      )}

      <section class="trips-replay" data-trips-replay aria-live="polite" hidden>
        <ol
          class="trips-replay__progress"
          data-replay-progress
          aria-label="回放进度"
        ></ol>
        <header class="trips-replay__header">
          <p data-replay-day></p>
          <h2>
            <span class="trips-replay__number" data-replay-number></span>
            <span data-replay-name></span>
          </h2>
          <p class="trips-replay__meta" data-replay-meta></p>
        </header>
        <div class="trips-replay__body">
          <div class="trips-replay__media" data-replay-media hidden></div>
          <p class="trips-replay__note" data-replay-note></p>
        </div>
        <footer class="trips-replay__controls">
          <button
            class="trips-tool"
            type="button"
            data-replay-previous
            aria-label="上一站"
            title="上一站"
          >
            <span class="i-ri-skip-back-fill" aria-hidden="true"></span>
          </button>
          <button
            class="trips-tool trips-replay__toggle"
            type="button"
            data-replay-toggle
            aria-label="暂停"
          >
            <span class="i-ri-pause-fill" aria-hidden="true"></span>
          </button>
          <button
            class="trips-tool"
            type="button"
            data-replay-next
            aria-label="下一站"
            title="下一站"
          >
            <span class="i-ri-skip-forward-fill" aria-hidden="true"></span>
          </button>
          <button
            class="trips-tool trips-replay__speed"
            type="button"
            data-replay-speed
            aria-label="倍速 1x"
            title="切换倍速"
          >
            1x
          </button>
          <button
            class="trips-tool"
            type="button"
            data-replay-exit
            aria-label="退出回放"
            title="退出回放"
          >
            <span class="i-ri-close-line" aria-hidden="true"></span>
          </button>
        </footer>
      </section>

      <PhotoDialog />
    </main>

    <script>
      import { mountTripsPage } from '~/utils/trips-page'

      let controller: AbortController | undefined
      let mountedPage: HTMLElement | undefined
      function bootTrips() {
        const page = document.querySelector<HTMLElement>('[data-trips]')
        if (!page || page === mountedPage) return
        controller?.abort()
        mountedPage = page
        controller = new AbortController()
        mountTripsPage(page, controller.signal)
      }
      document.addEventListener('astro:page-load', bootTrips)
      document.addEventListener('astro:before-swap', () => {
        controller?.abort()
        controller = undefined
        mountedPage = undefined
      })
      bootTrips()
    </script>
    <style is:global>
      @import 'maplibre-gl/dist/maplibre-gl.css';
      /* 地图与面板占满视口，不跟随正文滚动。 */
      html:has(.trips-body),
      .trips-body {
        height: 100%;
        overflow: hidden;
        overscroll-behavior: none;
      }

      @media (min-width: 48.0625rem) {
        .trips-page[data-trips-replaying] .maplibregl-ctrl-bottom-left {
          left: calc(min(22.5rem, 100vw - 2rem) + 1.25rem);
        }
      }
      @media (max-width: 48rem) {
        .trips-page[data-trips-replaying] .maplibregl-ctrl-bottom-left {
          display: none;
        }
      }
      .trips-popup {
        pointer-events: none;
      }

      .trips-popup .maplibregl-popup-content {
        display: grid;
        gap: 0.125rem;
        padding: 0.5rem 0.75rem;
        border-radius: 0.625rem;
        background: color-mix(in srgb, var(--c-bg) 92%, transparent);
        box-shadow: 0 6px 24px rgb(0 0 0 / 0.18);
        color: var(--c-text);
        font-family: inherit;
        font-size: 0.8125rem;
        backdrop-filter: blur(12px);

        & span {
          color: color-mix(in srgb, var(--c-text) 60%, var(--c-bg));
          font-variant-numeric: tabular-nums;
        }
      }

      .trips-popup .maplibregl-popup-tip {
        display: none;
      }

      .trips-replay-head {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 6;
        width: 0;
        height: 0;
        pointer-events: none;
      }

      .trips-replay-head__badge {
        position: absolute;
        top: -0.5625rem;
        left: -0.5625rem;
        display: grid;
        place-items: center;
        width: 1.125rem;
        height: 1.125rem;
        border: 2.5px solid #fff;
        border-radius: 999px;
        background: var(--trip-color);
        box-shadow: 0 2px 8px rgb(0 0 0 / 0.28);
        color: #fff;
        transition:
          top 180ms ease,
          left 180ms ease,
          width 180ms ease,
          height 180ms ease;
      }

      /* 路上时换成交通方式的图标圆章（复刻图 3）。 */
      .trips-replay-head--moving .trips-replay-head__badge {
        top: -0.875rem;
        left: -0.875rem;
        width: 1.75rem;
        height: 1.75rem;
        border: 2px solid var(--c-bg);
        background: var(--c-text);
        color: var(--c-bg);
        font-size: 0.9375rem;
      }

      .trips-replay-head__clock {
        position: absolute;
        top: 0;
        left: 1.125rem;
        display: grid;
        gap: 0.0625rem;
        width: max-content;
        padding: 0.3125rem 0.625rem 0.375rem;
        border: 1px solid color-mix(in srgb, var(--c-text) 14%, transparent);
        border-radius: 0.625rem;
        background: color-mix(in srgb, var(--c-bg) 94%, transparent);
        box-shadow: 0 4px 20px rgb(0 0 0 / 0.16);
        color: var(--c-text);
        line-height: 1.3;
        white-space: nowrap;
        translate: 0 -50%;
        backdrop-filter: blur(12px);
      }

      .trips-replay-head__clock[hidden] {
        display: none;
      }

      .trips-replay-head__clock small {
        color: color-mix(in srgb, var(--c-text) 56%, var(--c-bg));
        font-size: 0.6875rem;
        font-variant-numeric: tabular-nums;
      }

      .trips-replay-head__clock strong {
        font-size: 0.8125rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      .trips-stop-label {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 5;
        padding: 0.375rem 0.75rem;
        border: 1px solid color-mix(in srgb, var(--c-text) 14%, transparent);
        border-radius: 0.625rem;
        background: color-mix(in srgb, var(--c-bg) 94%, transparent);
        box-shadow: 0 4px 20px rgb(0 0 0 / 0.16);
        color: var(--c-text);
        font-size: 0.8125rem;
        font-weight: 500;
        line-height: 1.35;
        white-space: nowrap;
        pointer-events: none;
        backdrop-filter: blur(12px);
      }

      /*
       * 地图上的地点标记：根元素保持 0×0（不覆盖邻近点，也不在 MapLibre 的定位元素上做缩放），
       * 视觉子元素居中在锚点上：单张带白框与右下角年份色点，聚合是三张扇形叠片加右上角计数。
       */
      /* 必须保持 position: absolute（由 .maplibregl-marker 提供），绝不能写 position: relative。 */
      .trips-pin {
        position: absolute;
        top: 0;
        left: 0;
        display: block;
        width: 0;
        height: 0;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: pointer;
      }

      .trips-pin--cluster {
        width: 2.5rem;
        height: 2.5rem;
      }

      .trips-pin:focus-visible {
        outline: none;
      }

      .trips-pin > span {
        transition:
          transform 200ms cubic-bezier(0.34, 1.4, 0.64, 1),
          box-shadow 160ms ease;
      }

      .trips-pin:is(:hover, :focus-visible) {
        z-index: 3;
      }

      .trips-pin:is(:hover, :focus-visible)
        > :is(.trips-pin__photo, .trips-pin__dot, .trips-pin__stack) {
        transform: scale(1.12);
      }

      .trips-pin__dot {
        position: absolute;
        top: -0.5rem;
        left: -0.5rem;
        display: block;
        width: 1rem;
        height: 1rem;
        border: 2px solid #fff;
        border-radius: 999px;
        background: var(--trip-color);
        box-shadow: 0 1px 4px rgb(0 0 0 / 0.3);
      }

      .trips-pin__photo {
        position: relative;
        display: block;
        width: 2.25rem;
        height: 2.25rem;
        border: 2px solid #fff;
        border-radius: 0.625rem;
        background: #fff;
        box-shadow:
          0 1px 6px rgb(0 0 0 / 0.3),
          0 0 0 0.5px rgb(0 0 0 / 0.12);
      }

      .trips-pin > .trips-pin__photo {
        position: absolute;
        top: -1.125rem;
        left: -1.125rem;
      }

      .trips-pin__photo img,
      .trips-pin__face {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 0.5rem;
        background: var(--trip-color);
        object-fit: cover;
      }

      .trips-pin__year {
        position: absolute;
        right: -0.3125rem;
        bottom: -0.3125rem;
        width: 0.625rem;
        height: 0.625rem;
        border: 1.5px solid #fff;
        border-radius: 999px;
        background: var(--trip-color);
        box-shadow: 0 0 2px rgb(0 0 0 / 0.25);
      }

      .trips-pin__stack {
        position: relative;
        display: block;
        width: 2.5rem;
        height: 2.5rem;
      }

      .trips-pin__stack > .trips-pin__photo {
        position: absolute;
        inset: 0;
        width: auto;
        height: auto;
      }

      .trips-pin__stack > .trips-pin__photo:nth-last-child(3) {
        transform: translate(0.5625rem, -0.1875rem) rotate(10deg) scale(0.86);
      }

      .trips-pin__stack > .trips-pin__photo:nth-last-child(2) {
        transform: translate(-0.5rem, -0.125rem) rotate(-9deg) scale(0.9);
      }

      .trips-pin__count {
        position: absolute;
        top: -0.5rem;
        right: -0.625rem;
        min-width: 1.125rem;
        height: 1.125rem;
        padding: 0 0.25rem;
        border: 1.5px solid #fff;
        border-radius: 999px;
        background: var(--trip-color);
        box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
        color: #fff;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.625rem;
        font-weight: 600;
        line-height: calc(1.125rem - 3px);
        text-align: center;
        font-variant-numeric: tabular-nums;
      }

      .trips-pin.is-active {
        z-index: 4;
      }

      .trips-pin.is-active > :is(.trips-pin__photo, .trips-pin__dot) {
        transform: scale(1.18);
        box-shadow:
          0 0 0 3px var(--trip-color),
          0 3px 10px rgb(0 0 0 / 0.28);
      }

      @media (prefers-reduced-motion: reduce) {
        .trips-pin > span,
        .trips-replay-head {
          transition: none;
        }
      }
    </style>

    <style>
      .trips-page {
        --trips-glass: color-mix(in srgb, var(--c-bg) 86%, transparent);
        --trips-glass-border: color-mix(
          in srgb,
          var(--c-text) 10%,
          transparent
        );
        --trips-muted: color-mix(in srgb, var(--c-text) 58%, var(--c-bg));
        --trips-line: color-mix(in srgb, var(--c-text) 14%, transparent);
        --trips-hover: color-mix(in srgb, var(--c-text) 6%, transparent);
        --trips-panel-width: 26rem;
        position: fixed;
        inset: 0;
        background: color-mix(in srgb, var(--c-text) 8%, var(--c-bg));
        color: var(--c-text);
      }

      .trips-canvas {
        position: absolute;
        inset: 0;
        z-index: 0;
        isolation: isolate;
      }

      .trips-message {
        position: absolute;
        top: 50%;
        left: calc((100% - var(--trips-panel-width) - 2rem) / 2);
        max-width: min(22rem, 80vw);
        margin: 0;
        color: var(--trips-muted);
        font-size: 0.875rem;
        text-align: center;
        translate: -50% -50%;
      }

      /* —— 顶栏 —— */
      .trips-toolbar {
        position: absolute;
        top: calc(1rem + env(safe-area-inset-top));
        left: calc(1rem + env(safe-area-inset-left));
        right: calc(var(--trips-panel-width) + 2.5rem);
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        pointer-events: none;

        & > * {
          pointer-events: auto;
        }
      }

      .trips-page[data-trips-collapsed] .trips-toolbar,
      .trips-page[data-trips-replaying] .trips-toolbar {
        right: calc(1rem + env(safe-area-inset-right));
      }

      .trips-home,
      .trips-tool {
        border: 1px solid var(--trips-glass-border);
        background: var(--trips-glass);
        box-shadow: 0 6px 24px rgb(0 0 0 / 0.08);
        backdrop-filter: blur(14px);
      }

      .trips-home {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        gap: 0.5rem;
        height: 2.5rem;
        padding: 0 0.875rem 0 0.3125rem;
        border-radius: 999px;
        color: var(--c-text);
        font-size: 0.875rem;
        font-weight: 500;
        white-space: nowrap;
        text-decoration: none;

        & img {
          flex-shrink: 0;
          width: 1.875rem;
          height: 1.875rem;
          border-radius: 999px;
        }

        &:hover {
          background: color-mix(in srgb, var(--c-bg) 96%, var(--c-text));
        }
      }

      .trips-toolbar__actions {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 0.5rem;
      }

      .trips-tool {
        display: grid;
        flex-shrink: 0;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 999px;
        color: color-mix(in srgb, var(--c-text) 72%, var(--c-bg));
        cursor: pointer;

        & span {
          font-size: 1.125rem;
        }

        &:hover:not(:disabled) {
          color: var(--c-text);
        }

        &:disabled {
          cursor: default;
          opacity: 0.4;
        }
      }

      .trips-home:focus-visible,
      .trips-tool:focus-visible,
      .trip-card:focus-visible,
      .trips-settings :focus-visible {
        outline: 2px solid var(--c-text);
        outline-offset: 2px;
      }

      .trips-tool[aria-expanded='true'] {
        color: var(--c-text);
      }

      /* —— 地图设置：工具栏下方弹出，与工具栏右对齐 —— */
      .trips-settings {
        position: absolute;
        top: calc(4.25rem + env(safe-area-inset-top));
        right: calc(var(--trips-panel-width) + 2.5rem);
        z-index: 4;
        display: grid;
        gap: 1rem;
        width: min(20rem, calc(100% - 2rem));
        max-height: calc(100dvh - 6rem);
        overflow-y: auto;
        padding: 1rem;
        border: 1px solid var(--trips-glass-border);
        border-radius: 1.125rem;
        background: color-mix(in srgb, var(--c-bg) 94%, transparent);
        box-shadow: 0 12px 40px rgb(0 0 0 / 0.16);
        backdrop-filter: blur(18px);

        &[hidden] {
          display: none;
        }
      }

      .trips-page[data-trips-collapsed] .trips-settings,
      .trips-page[data-trips-replaying] .trips-settings {
        right: calc(1rem + env(safe-area-inset-right));
      }

      .trips-settings__header {
        position: relative;

        & p {
          margin: 0;
          color: var(--trips-muted);
          font-size: 0.75rem;
        }

        & h2 {
          margin: 0.125rem 0 0;
          font-size: 1.0625rem;
          font-weight: 600;
        }
      }

      .trips-settings__close {
        position: absolute;
        top: -0.25rem;
        right: -0.25rem;
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border: 0;
        border-radius: 999px;
        background: none;
        color: var(--trips-muted);
        font-size: 1.125rem;
        cursor: pointer;

        &:hover {
          background: var(--trips-hover);
          color: var(--c-text);
        }
      }

      .trips-settings__styles {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        border: 0;

        & legend {
          margin-bottom: 0.5rem;
          padding: 0;
          color: var(--trips-muted);
          font-size: 0.75rem;
        }
      }

      .trips-style {
        display: grid;
        gap: 0.125rem;
        padding: 0.5rem 0.625rem;
        border: 1px solid var(--trips-line);
        border-radius: 0.75rem;
        cursor: pointer;

        & input {
          position: absolute;
          opacity: 0;
          pointer-events: none;
        }

        & strong {
          font-size: 0.875rem;
          font-weight: 500;
        }

        & small {
          color: var(--trips-muted);
          font-size: 0.6875rem;
          line-height: 1.4;
        }

        &:hover {
          background: var(--trips-hover);
        }

        &:has(input:checked) {
          border-color: var(--c-text);
          background: var(--c-text);
          color: var(--c-bg);

          & small {
            color: color-mix(in srgb, var(--c-bg) 70%, var(--c-text));
          }
        }

        &:has(input:focus-visible) {
          outline: 2px solid var(--c-text);
          outline-offset: 2px;
        }
      }

      .trips-switch {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        cursor: pointer;

        & span {
          display: grid;
          gap: 0.125rem;
        }

        & strong {
          font-size: 0.875rem;
          font-weight: 500;
        }

        & small {
          color: var(--trips-muted);
          font-size: 0.75rem;
        }

        & input {
          flex-shrink: 0;
          width: 2.5rem;
          height: 1.5rem;
          margin: 0;
          appearance: none;
          border-radius: 999px;
          background: var(--trips-line);
          cursor: pointer;
          transition: background-color 160ms ease;

          &::before {
            display: block;
            width: 1.125rem;
            height: 1.125rem;
            margin: 0.1875rem;
            border-radius: 999px;
            background: var(--c-bg);
            box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
            content: '';
            transition: translate 160ms ease;
          }

          &:checked {
            background: var(--c-text);

            &::before {
              translate: 1rem 0;
            }
          }
        }
      }

      .trips-settings__reset {
        justify-self: start;
        padding: 0.25rem 0;
        border: 0;
        background: none;
        color: var(--trips-muted);
        font: inherit;
        font-size: 0.8125rem;
        cursor: pointer;

        &:hover {
          color: var(--c-text);
        }
      }

      /* —— 面板 —— */
      .trips-panel {
        position: absolute;
        top: calc(1rem + env(safe-area-inset-top));
        right: calc(1rem + env(safe-area-inset-right));
        bottom: 1rem;
        z-index: 2;
        display: flex;
        width: var(--trips-panel-width);
        overflow: hidden;
        border: 1px solid var(--trips-glass-border);
        border-radius: 1.25rem;
        background: color-mix(in srgb, var(--c-bg) 94%, transparent);
        box-shadow: 0 12px 40px rgb(0 0 0 / 0.14);
        backdrop-filter: blur(18px);
        transition:
          translate 260ms cubic-bezier(0.2, 0.7, 0.2, 1),
          opacity 200ms ease;
      }

      .trips-page[data-trips-collapsed] .trips-panel,
      .trips-page[data-trips-replaying] .trips-panel {
        opacity: 0;
        pointer-events: none;
        translate: calc(100% + 1.5rem) 0;
      }

      .trips-panel__scroll {
        flex: 1;
        min-width: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: thin;
      }

      .trips-overview__header {
        padding: 1.25rem 1.25rem 0.5rem;

        & p {
          margin: 0;
          color: var(--trips-muted);
          font-size: 0.875rem;
          font-variant-numeric: tabular-nums;
        }

        & h1 {
          margin: 0.25rem 0 0;
          font-family: var(--font-heading);
          font-size: 1.5rem;
          font-weight: 600;
        }
      }

      .trips-overview__header .trips-overview__source {
        margin-top: 0.25rem;
        font-size: 0.75rem;
      }

      .trips-empty {
        padding: 0 1.25rem;
        color: var(--trips-muted);
      }

      .trips-year {
        position: sticky;
        top: 0;
        z-index: 1;
        margin: 0;
        padding: 0.75rem 1.25rem 0.375rem;
        background: color-mix(in srgb, var(--c-bg) 94%, transparent);
        color: var(--trips-muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
        font-weight: 400;
        backdrop-filter: blur(18px);
      }

      .trips-list {
        margin: 0;
        padding: 0 0.5rem 0.5rem;
        list-style: none;
      }

      .trip-card {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        padding: 0.5rem 0.5rem 0.75rem;
        border-radius: 0.875rem;
        color: var(--c-text);
        text-decoration: none;
        transition: background-color 140ms ease;

        &:hover {
          background: var(--trips-hover);
        }

        & :global(.trip-cover) {
          margin-bottom: 0.5rem;
        }
      }

      .trip-card__title {
        padding: 0 0.25rem;
        font-size: 1.0625rem;
        font-weight: 600;
      }

      .trip-card__dates,
      .trip-card__totals {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0 0.25rem;
        color: var(--trips-muted);
        font-size: 0.875rem;
        font-variant-numeric: tabular-nums;
      }

      .trip-card__totals {
        font-size: 0.8125rem;
      }

      .trips-page :global(.trip-status) {
        flex-shrink: 0;
        padding: 0.0625rem 0.4375rem;
        border-radius: 999px;
        font-size: 0.6875rem;
        font-weight: 600;
        line-height: 1.4;
      }

      .trips-page :global(.trip-status[data-trip-status='plan']) {
        background: color-mix(in srgb, var(--accent, #3b82f6) 16%, transparent);
        color: color-mix(in srgb, var(--accent, #3b82f6) 80%, var(--c-text));
      }

      .trips-page :global(.trip-status[data-trip-status='record']) {
        background: var(--trips-hover);
        color: var(--trips-muted);
      }

      /* 选中状态：无 JS 用 :target，有 JS 时由 hashchange 同步同一个片段。 */
      .trips-page :global(.trip-detail) {
        display: none;
        padding-top: 1rem;
      }

      .trips-page :global(.trip-detail:is(:target, [data-active])) {
        display: block;
      }

      .trips-panel:has(:global(.trip-detail:is(:target, [data-active])))
        .trips-overview {
        display: none;
      }

      /* —— 图例 —— */
      .trips-legend {
        position: absolute;
        bottom: calc(2.25rem + env(safe-area-inset-bottom));
        left: 50%;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 0.625rem;
        max-width: calc(100% - var(--trips-panel-width) - 3.5rem);
        padding: 0.25rem 0.875rem 0.25rem 0.25rem;
        overflow-x: auto;
        border: 1px solid var(--trips-glass-border);
        border-radius: 999px;
        background: var(--trips-glass);
        color: color-mix(in srgb, var(--c-text) 72%, var(--c-bg));
        font-size: 0.8125rem;
        white-space: nowrap;
        translate: calc(-50% - (var(--trips-panel-width) + 2rem) / 2) 0;
        scrollbar-width: none;
        backdrop-filter: blur(14px);

        & ul {
          display: flex;
          align-items: center;
          gap: 0.125rem;
          margin: 0;
          padding: 0;
          list-style: none;
        }

        & li {
          display: flex;
          align-items: center;
          gap: 0.375rem;
        }
      }

      .trips-page[data-trips-collapsed] .trips-legend {
        translate: -50% 0;
      }

      .trips-page[data-trips-replaying] .trips-legend {
        display: none;
      }

      /* 年份按钮：选中一年时其余变淡，再点一次回到全部。 */
      .trips-legend button {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        height: 2rem;
        padding: 0 0.625rem;
        border: 0;
        border-radius: 999px;
        background: none;
        color: inherit;
        font: inherit;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        cursor: pointer;
        transition:
          background-color 140ms ease,
          opacity 140ms ease;

        &:disabled {
          cursor: default;
        }

        &:not(:disabled):hover {
          background: var(--trips-hover);
        }

        &[aria-pressed='true'] {
          background: var(--trips-hover);
          color: var(--c-text);
        }

        &:focus-visible {
          outline: 2px solid var(--c-text);
          outline-offset: 1px;
        }
      }

      .trips-legend:has([aria-pressed='true'])
        button:not([aria-pressed='true']) {
        opacity: 0.45;
      }

      .trips-legend__dot {
        width: 0.625rem;
        height: 0.625rem;
        border-radius: 999px;
        background: var(--trip-color);
      }

      .trips-legend__routes {
        gap: 0.75rem !important;
        padding-left: 0.75rem !important;
        border-left: 1px solid var(--trips-line);
      }

      .trips-legend__line {
        width: 1.125rem;
        height: 3px;
        border-radius: 3px;
        background: currentcolor;
      }

      .trips-legend__line--flight {
        height: 4px;
        border-radius: 0;
        background: repeating-linear-gradient(
          90deg,
          currentcolor 0 4px,
          transparent 4px 7px
        );
      }

      /* —— 日历记录详情 —— */
      .calendar-detail {
        padding: 1rem 1.25rem 1.5rem;

        & :global(.calendar-entry) {
          padding-top: 0.5rem;
        }
      }

      .calendar-detail__back,
      .calendar-detail__month {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--trips-muted);
        font-size: 0.875rem;
        text-decoration: none;

        &:hover,
        &:focus-visible {
          color: var(--c-text);
        }
      }

      .calendar-detail__month {
        margin-top: 0.5rem;
        font-size: 0.8125rem;
      }

      /* —— 回放面板：复刻参考博客左下角纵向卡片（窄屏在底部） —— */
      .trips-replay {
        position: absolute;
        bottom: calc(1rem + env(safe-area-inset-bottom));
        left: calc(1rem + env(safe-area-inset-left));
        z-index: 10;
        display: flex;
        flex-direction: column;
        width: min(22.5rem, calc(100% - 2rem));
        max-height: calc(100dvh - 6rem);
        overflow: hidden;
        border: 1px solid var(--trips-glass-border);
        border-radius: 0.875rem;
        background: color-mix(in srgb, var(--c-bg) 96%, transparent);
        box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 0.18);
        backdrop-filter: blur(18px);

        &[hidden] {
          display: none;
        }

        & h2 {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          margin: 0.125rem 0 0;
          font-size: 1.0625rem;
          font-weight: 600;
          line-height: 1.4;
        }

        & p {
          margin: 0;
          color: var(--trips-muted);
          font-size: 0.75rem;
          line-height: 1.25;
        }

        & [hidden] {
          display: none;
        }
      }

      .trips-replay__progress {
        display: flex;
        flex-shrink: 0;
        gap: 0.1875rem;
        margin: 0;
        padding: 0.75rem 1rem 0;
        list-style: none;
      }

      .trips-replay :global(.trips-replay__progress-item) {
        flex: 1 1 0%;
        min-width: 0;
      }

      .trips-replay :global(.trips-replay__progress-btn) {
        display: block;
        width: 100%;
        margin: -0.375rem 0;
        padding: 0.375rem 0;
        border: 0;
        background: transparent;
        cursor: pointer;
      }

      .trips-replay :global(.trips-replay__progress-bar) {
        display: block;
        height: 0.125rem;
        overflow: hidden;
        border-radius: 999px;
        background: var(--trips-line);
      }

      .trips-replay :global(.trips-replay__progress-fill) {
        display: block;
        width: 100%;
        height: 100%;
        background: var(--c-text);
        transform: scaleX(0);
        transform-origin: left;
      }

      .trips-replay__header {
        flex-shrink: 0;
        padding: 0.625rem 1rem 0.25rem;
      }

      .trips-replay__meta {
        margin-top: 0.125rem !important;
      }

      .trips-replay__body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-height: 0;
        padding: 0.375rem 1rem 0.75rem;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: none;
      }

      .trips-replay__media {
        width: 100%;
      }

      .trips-replay__media :global(button) {
        display: block;
        width: 100%;
        padding: 0;
        overflow: hidden;
        border: 0;
        border-radius: 0.5rem;
        background: var(--trips-hover);
        cursor: zoom-in;
      }

      .trips-replay__media :global(button:focus-visible) {
        outline: 2px solid var(--c-text);
        outline-offset: 2px;
      }

      .trips-replay__media :global(img) {
        display: block;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        object-fit: cover;
      }

      .trips-replay__media.is-grid {
        display: grid;
        grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
        gap: 0.25rem;
      }

      .trips-replay__media.is-grid :global(.trips-replay__grid-btn) {
        aspect-ratio: 1;
        transition: opacity 150ms ease;
      }

      .trips-replay__media.is-grid :global(.trips-replay__grid-btn:only-child) {
        aspect-ratio: 4 / 3;
        max-height: 14rem;
      }

      .trips-replay__media.is-grid
        :global(.trips-replay__grid-btn[aria-current]) {
        box-shadow: inset 0 0 0 2px var(--c-text);
      }

      .trips-replay :global(.trips-replay__main) {
        aspect-ratio: 4 / 3;
        max-height: 14rem;
      }

      .trips-replay :global(.trips-replay__strip) {
        display: flex;
        gap: 0.25rem;
        margin-top: 0.375rem;
        overflow-x: auto;
        scrollbar-width: none;
      }

      .trips-replay :global(.trips-replay__strip button) {
        flex: none;
        width: 2.625rem;
        height: 2.625rem;
        border-radius: 0.375rem;
        cursor: pointer;
        opacity: 0.55;
        transition: opacity 140ms ease;
      }

      .trips-replay :global(.trips-replay__strip button[aria-current]) {
        opacity: 1;
        outline: 2px solid var(--c-text);
        outline-offset: -2px;
      }

      .trips-replay[data-replay-kind='day'] h2 {
        font-size: 1.125rem;
      }

      .trips-replay__number {
        display: grid;
        flex-shrink: 0;
        place-items: center;
        width: 1.375rem;
        height: 1.375rem;
        border-radius: 999px;
        background: var(--c-text);
        color: var(--c-bg);
        font-size: 0.6875rem;
        font-variant-numeric: tabular-nums;
      }

      .trips-replay .trips-replay__note {
        color: var(--c-text);
        font-size: 0.8125rem;
        line-height: 1.5;
        white-space: pre-line;
      }

      .trips-replay__controls {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 0.25rem;
        padding: 0.375rem 0.625rem;
        border-top: 1px solid var(--trips-glass-border);
        background: color-mix(in srgb, var(--c-bg) 96%, transparent);

        & .trips-tool {
          width: 2.125rem;
          height: 2.125rem;
          border: 0;
          background: transparent;
          box-shadow: none;
          backdrop-filter: none;
        }

        & .trips-tool:hover:not(:disabled) {
          background: var(--trips-hover);
        }

        & .trips-replay__toggle {
          background: var(--c-text);
          color: var(--c-bg);

          &:hover:not(:disabled) {
            background: var(--c-text);
            color: var(--c-bg);
            opacity: 0.88;
          }
        }

        & .trips-replay__speed {
          width: auto;
          min-width: 2.5rem;
          margin-left: auto;
          padding: 0 0.5rem;
          font: inherit;
          font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          font-size: 0.75rem;
        }
      }

      /* —— 中等屏（769px–992px）：面板展开时收紧宽度与左上角文字，防顶栏挤压 —— */
      @media (max-width: 62rem) {
        .trips-page {
          --trips-panel-width: min(22.5rem, 42vw);
        }
      }
      @media (max-width: 58rem) {
        .trips-page:not([data-trips-collapsed], [data-trips-replaying])
          .trips-home
          span {
          display: none;
        }
        .trips-page:not([data-trips-collapsed], [data-trips-replaying])
          .trips-home {
          padding: 0 0.3125rem;
        }
        .trips-page:not([data-trips-collapsed]) .trips-legend__routes {
          display: none !important;
        }
      }
      /* —— 窄屏：面板成为底部面板 —— */
      @media (max-width: 48rem) {
        .trips-page {
          --trips-panel-width: 0rem;
        }

        .trips-toolbar,
        .trips-settings {
          right: calc(1rem + env(safe-area-inset-right));
        }

        .trips-home span {
          display: none;
        }

        .trips-home {
          padding: 0 0.375rem;
        }

        .trips-panel {
          top: auto;
          right: 0.5rem;
          bottom: 0.5rem;
          left: 0.5rem;
          width: auto;
          height: 56dvh;
        }

        .trips-page[data-trips-collapsed] .trips-panel,
        .trips-page[data-trips-replaying] .trips-panel {
          translate: 0 calc(100% + 1rem);
        }

        /* 年份挑在顶栏下方，路线样式不再列出。 */
        .trips-legend {
          top: calc(4.25rem + env(safe-area-inset-top));
          bottom: auto;
          left: 1rem;
          max-width: calc(100% - 2rem);
          padding-right: 0.25rem;
          overflow-x: auto;
          translate: none;
          scrollbar-width: none;
        }

        .trips-page[data-trips-collapsed] .trips-legend {
          translate: none;
        }

        .trips-legend__routes {
          display: none !important;
        }

        .trips-message {
          top: 22%;
          left: 50%;
        }

        .trips-replay {
          right: calc(0.75rem + env(safe-area-inset-right));
          bottom: calc(0.75rem + env(safe-area-inset-bottom));
          left: calc(0.75rem + env(safe-area-inset-left));
          width: auto;
          max-height: 54dvh;
        }

        /* 窄屏只留切换胶囊的图标。 */
        .trips-toolbar :global(.view-switch a) {
          min-width: 2.25rem;
          gap: 0;
          padding: 0 0.5rem;
          font-size: 0;

          & span {
            font-size: 1rem;
          }
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .trips-panel,
        .trips-switch input,
        .trips-switch input::before {
          transition: none;
        }
      }
    </style>
  </body>
</html>
