---
import TocItem from '~/components/toc/TocItem.astro'
import Link from '~/components/base/Link.astro'
import { generateToc } from '~/utils/toc'
import { FEATURES } from '~/config'

import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props

const { toc } = FEATURES
if (!toc || (Array.isArray(toc) && !toc[0])) return
const { minHeadingLevel, maxHeadingLevel } = toc[1]
const specHeadings = generateToc(headings, minHeadingLevel, maxHeadingLevel)
---

<nav id="toc-sidebar" class="desktop-toc" aria-label="Table of contents">
  <Link
    href="#skip-toc"
    class="sr-only focus:(not-sr-only fixed start-1 top-1.5 op-20)"
  >
    Skip toc
  </Link>
  <ul class="desktop-toc__list">
    {specHeadings.map((heading) => (
      <TocItem {heading} />
    ))}
  </ul>
  <div id="skip-toc" class="hidden"></div>
</nav>

<style>
  .desktop-toc {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    max-height: 66vh;
    overflow: hidden;
    font-size: calc(var(--blog-reading-size) * 0.9);
  }

  .desktop-toc__list {
    height: 100%;
    min-height: 0;
    overflow-y: auto;
  }
</style>
