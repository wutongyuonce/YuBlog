---
import { Image, getImage } from 'astro:assets'
import { render } from 'astro:content'

import { entryHash, formatEntryDate } from '~/utils/calendar.js'
import { withBasePath } from '~/utils/path'
import type { CalendarEntry } from '~/utils/trip-entries'

// 一条日历记录：标题、右侧的地点、时间、照片和正文。日历时间线与旅行页面板共用。
interface Props {
  entry: CalendarEntry
  /** 日历的时间线左侧已有日期，只写时间；旅行页面板写完整日期。 */
  showDate?: boolean
  /** 地点是否链到旅行地图；已经在地图上时不链。 */
  linkPlace?: boolean
}

const { entry, showDate = false, linkPlace = true } = Astro.props
const { id, data } = entry
const { Content } = await render(entry)
const hasBody = Boolean(entry.body?.trim())
const when = showDate ? formatEntryDate(data) : data.time
const label = data.title ?? data.place?.name ?? formatEntryDate(data)
const photos = await Promise.all(
  data.photos.map(async (photo) => ({
    photo,
    large: (
      await getImage({
        src: photo,
        width: Math.min(1280, photo.width),
        format: 'webp',
      })
    ).src,
  }))
)
---

<article
  class="calendar-entry"
  data-calendar-entry={id}
  data-photo-group
  aria-label={label}
>
  {(data.title || when || data.place) && (
    <header class="calendar-entry__header">
      {data.title ? (
        <h3 id={`calendar-${id}-title`}>{data.title}</h3>
      ) : (
        when && <p class="calendar-entry__time">{when}</p>
      )}
      {data.place &&
        (linkPlace ? (
          <a
            class="calendar-entry__place"
            href={withBasePath(`/trips/#${entryHash(id)}`)}
            aria-label={`在地图上查看：${data.place.name}`}
          >
            <span class="i-ri-map-pin-line" aria-hidden="true" />
            {data.place.name}
          </a>
        ) : (
          <span class="calendar-entry__place">
            <span class="i-ri-map-pin-line" aria-hidden="true" />
            {data.place.name}
          </span>
        ))}
    </header>
  )}
  {data.title && when && <p class="calendar-entry__time">{when}</p>}
  {photos.length > 0 && (
    <ul
      class:list={[
        'calendar-entry__photos',
        `calendar-entry__photos--${Math.min(photos.length, 4)}`,
      ]}
    >
      {photos.map(({ photo, large }, index) => (
        <li>
          <a
            href={large}
            data-photo
            data-caption={label}
            aria-label={`查看大图：${label} 第 ${index + 1} 张`}
          >
            <Image
              src={photo}
              alt={`${label} 照片 ${index + 1}`}
              widths={[240, 480, 960]}
              sizes={photos.length === 1 ? '24rem' : '12rem'}
              format="webp"
              loading="lazy"
            />
          </a>
        </li>
      ))}
    </ul>
  )}
  {hasBody && (
    <div class="calendar-entry__body">
      <Content />
    </div>
  )}
</article>

<style>
  .calendar-entry {
    padding: 0.25rem 0;
  }

  .calendar-entry__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;

    & h3 {
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.5;
    }
  }

  .calendar-entry__place {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    max-width: 100%;
    color: color-mix(in srgb, var(--c-text) 58%, var(--c-bg));
    font-size: 0.8125rem;
    text-decoration: none;

    &:is(a):hover,
    &:is(a):focus-visible {
      color: var(--c-text);
    }

    &:is(a):focus-visible {
      outline: 2px solid var(--c-text);
      outline-offset: 2px;
      border-radius: 0.25rem;
    }
  }

  .calendar-entry__time {
    margin: 0.125rem 0 0;
    color: color-mix(in srgb, var(--c-text) 58%, var(--c-bg));
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
  }

  .calendar-entry__photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;

    & li {
      min-width: 0;
    }

    & a {
      display: block;
      overflow: hidden;
      border-radius: 0.375rem;
      aspect-ratio: 4 / 3;
      background: color-mix(in srgb, var(--c-text) 4%, var(--c-bg));
      cursor: zoom-in;

      &:focus-visible {
        outline: 2px solid var(--c-text);
        outline-offset: 2px;
      }
    }

    & img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: scale 180ms ease;
    }

    & a:hover img {
      scale: 1.025;
    }
  }

  .calendar-entry__photos--1 {
    grid-template-columns: minmax(0, 1fr);

    & a {
      aspect-ratio: auto;
      max-height: 28rem;
    }

    & img {
      height: auto;
      max-height: 28rem;
      object-fit: contain;
    }
  }

  .calendar-entry__photos--3 > li:first-child {
    grid-row: span 2 / span 2;

    & a {
      height: 100%;
      aspect-ratio: auto;
    }
  }

  .calendar-entry__body {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.75;

    & :global(p) {
      margin: 0.5rem 0 0;
    }

    & :global(p:first-child) {
      margin-top: 0;
    }

    & :global(a) {
      color: inherit;
      text-underline-offset: 0.2em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .calendar-entry__photos img {
      transition: none;
    }
  }
</style>
