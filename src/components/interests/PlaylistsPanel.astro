---
import playlists from '~/data/playlists.json'
import { withBasePath } from '~/utils/path'

const config = playlists.map((entry) => ({
  ...entry,
  cover: withBasePath(entry.cover),
}))
---

<playlist-panel
  class="playlists-panel"
  data-config={JSON.stringify(config)}
  data-state="loading"
  role="region"
  aria-label="歌单收藏"
  aria-busy="true"
>
  <div class="playlists-panel__interactive">
    <div class="playlists-panel__cards">
      {config.map((entry) => (
        <article
          class="playlists-panel__card"
          data-playlist-id={entry.id}
          aria-labelledby={`playlist-title-${entry.id}`}
        >
          <button type="button" data-export disabled>
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path
                d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            导出文本
          </button>

          <div data-details hidden>
            <div class="playlists-panel__header">
              <img
                class="playlists-panel__cover"
                data-cover
                src={entry.cover}
                width="144"
                height="144"
                alt=""
                loading="eager"
              />
              <div class="playlists-panel__info">
                <div class="playlists-panel__topline">
                  <span class="playlists-panel__source">
                    {entry.platform === 'qq' ? 'QQ 音乐' : '网易云音乐'}
                  </span>
                  <p class="playlists-panel__meta" data-meta hidden>
                    <span>
                      by <span data-author />
                    </span>
                    <span class="playlists-panel__meta-sep" aria-hidden="true">
                      ·
                    </span>
                    <span class="playlists-panel__count" data-count />
                  </p>
                </div>
                <h2 id={`playlist-title-${entry.id}`}>
                  <a
                    data-title
                    href={entry.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {entry.title || entry.id}
                  </a>
                </h2>
                <p
                  class="playlists-panel__description"
                  data-description
                  hidden
                />
              </div>
            </div>
          </div>

          <div data-skeleton aria-hidden="true">
            <div class="playlists-panel__header">
              <div class="playlists-panel__cover playlists-panel__bone" />
              <div class="playlists-panel__info playlists-panel__skeleton-info">
                <span class="playlists-panel__bone" />
                <span class="playlists-panel__bone" />
                <span class="playlists-panel__bone" />
                <span class="playlists-panel__bone" />
              </div>
            </div>
          </div>

          <p class="playlists-panel__note" data-note hidden />
        </article>
      ))}
    </div>
    <div class="playlists-panel__footer">
      <p
        class="playlists-panel__status"
        data-status
        role="status"
        aria-live="polite"
      >
        正在获取歌单…
      </p>
      <time data-updated hidden />
    </div>
  </div>

  <noscript>
    <style>
      .playlists-panel__interactive {
        display: none;
      }
    </style>
    <p class="playlists-panel__fallback">
      启用 JavaScript 后可查看歌单详情并导出文本，也可以前往原歌单查看：
      {config.map((entry) => (
        <a href={entry.url} target="_blank" rel="noopener noreferrer">
          {entry.title || entry.id}
        </a>
      ))}
    </p>
  </noscript>
</playlist-panel>

<script>
  import { mountPlaylists } from '~/utils/playlists-ui'

  class PlaylistPanel extends HTMLElement {
    private cleanup?: () => void
    connectedCallback() {
      this.cleanup = mountPlaylists(this)
    }
    disconnectedCallback() {
      this.cleanup?.()
    }
  }
  if (!customElements.get('playlist-panel'))
    customElements.define('playlist-panel', PlaylistPanel)
</script>

<style>
  .playlists-panel {
    --playlist-muted: color-mix(in srgb, var(--c-text) 62%, var(--c-bg));
    --playlist-line: color-mix(in srgb, var(--c-text) 10%, transparent);
    --playlist-cover-edge: color-mix(in srgb, var(--c-text) 10%, transparent);
    display: block;
    min-width: 0;
    margin-top: 2rem;
    font-size: 0.875rem;
  }
  [hidden] {
    display: none !important;
  }
  .playlists-panel__cards {
    display: grid;
    gap: 1.25rem;
  }
  .playlists-panel__card {
    --playlist-tint: 132 136 148;
    --playlist-tint-soft: 168 172 184;
    position: relative;
    min-width: 0;
    padding: 1.25rem 1.35rem 1.35rem;
    border: 1px solid
      color-mix(in srgb, rgb(var(--playlist-tint)) 26%, var(--playlist-line));
    border-radius: 1rem;
    background:
      linear-gradient(
        145deg,
        rgb(var(--playlist-tint) / 0.2),
        rgb(var(--playlist-tint-soft) / 0.08) 42%,
        color-mix(in srgb, var(--c-bg) 55%, transparent) 100%
      ),
      color-mix(in srgb, var(--c-bg) 62%, transparent);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 1px 2px color-mix(in srgb, var(--c-text) 4%, transparent),
      0 10px 28px rgb(var(--playlist-tint) / 0.1);
    backdrop-filter: blur(14px) saturate(1.15);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
    transition:
      border-color 280ms ease,
      box-shadow 280ms ease,
      background-color 280ms ease;
  }
  .playlists-panel__card[data-tint='ready'] {
    border-color: color-mix(
      in srgb,
      rgb(var(--playlist-tint)) 34%,
      var(--playlist-line)
    );
  }
  .playlists-panel__header {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.35rem;
    align-items: start;
  }
  .playlists-panel__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.6rem;
    border: 1px solid var(--playlist-cover-edge);
    background: color-mix(in srgb, var(--c-text) 6%, var(--c-bg));
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--c-text) 6%, transparent),
      0 8px 20px color-mix(in srgb, var(--c-text) 5%, transparent);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  .playlists-panel__cover:not(.playlists-panel__bone):hover {
    transform: translateY(-2px);
    box-shadow:
      0 2px 4px color-mix(in srgb, var(--c-text) 8%, transparent),
      0 12px 28px color-mix(in srgb, var(--c-text) 8%, transparent);
  }
  .playlists-panel__info {
    min-width: 0;
    padding-top: 0.125rem;
    padding-right: 6.5rem;
  }
  .playlists-panel__topline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-start;
    gap: 0.25rem 0.75rem;
  }
  .playlists-panel__source {
    color: var(--playlist-muted);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
  }
  h2 {
    margin: 0.35rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  h2 a {
    color: color-mix(in srgb, var(--c-text) 88%, transparent);
    border-bottom: 1px solid transparent;
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }
  h2 a:hover,
  h2 a:focus-visible {
    color: var(--accent);
    border-bottom-color: currentColor;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .playlists-panel__meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem;
    margin: 0;
    color: var(--playlist-muted);
    font-size: 0.75rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .playlists-panel__meta-sep {
    color: color-mix(in srgb, var(--playlist-muted) 70%, transparent);
  }
  .playlists-panel__count {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .playlists-panel__description {
    margin: 0.7rem 0 0;
    color: var(--playlist-muted);
    font-size: 0.875rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }
  button[data-export] {
    position: absolute;
    top: 1.15rem;
    right: 1.15rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--c-text) 14%, transparent);
    border-radius: 999px;
    color: var(--playlist-muted);
    background: color-mix(in srgb, var(--c-bg) 45%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font: inherit;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }
  button:enabled {
    cursor: pointer;
  }
  button:enabled:hover {
    color: var(--c-text);
    border-color: color-mix(in srgb, var(--c-text) 28%, transparent);
    background: color-mix(in srgb, var(--c-bg) 70%, transparent);
  }
  button:disabled {
    opacity: 0.45;
  }
  .playlists-panel__note {
    margin: 0.75rem 0 0;
    color: var(--playlist-muted);
    font-size: 0.75rem;
    line-height: 1.8;
  }
  .playlists-panel__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1rem;
    padding-top: 0.35rem;
    color: var(--playlist-muted);
    font-size: 0.6875rem;
    line-height: 1.8;
  }
  .playlists-panel__status {
    margin: 0;
  }
  [data-state='ready'] .playlists-panel__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  [data-state='failed'] .playlists-panel__footer {
    justify-content: flex-start;
    font-size: 0.8125rem;
  }
  .playlists-panel__fallback {
    color: var(--playlist-muted);
    line-height: 1.8;
    font-size: 0.875rem;
  }
  .playlists-panel__fallback a {
    display: inline-block;
    margin-inline-end: 0.75rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .playlists-panel__bone {
    display: block;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--c-text) 7%, var(--c-bg));
    animation: playlist-pulse 1.8s ease-in-out infinite;
  }
  .playlists-panel__cover.playlists-panel__bone {
    border-radius: 0.6rem;
    box-shadow: none;
  }
  .playlists-panel__skeleton-info {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }
  .playlists-panel__skeleton-info span {
    height: 0.75rem;
    width: 38%;
  }
  .playlists-panel__skeleton-info span:nth-child(2) {
    height: 1.5rem;
    width: 88%;
    margin-top: 0.15rem;
  }
  .playlists-panel__skeleton-info span:nth-child(3),
  .playlists-panel__skeleton-info span:nth-child(4) {
    width: 92%;
    margin-top: 0.15rem;
  }
  .playlists-panel__skeleton-info span:nth-child(4) {
    width: 64%;
  }
  @keyframes playlist-pulse {
    50% {
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .playlists-panel__bone {
      animation: none;
    }
    a,
    button,
    .playlists-panel__cover,
    .playlists-panel__card {
      transition: none;
    }
    .playlists-panel__cover:not(.playlists-panel__bone):hover {
      transform: none;
    }
  }
  @media (max-width: 600px) {
    .playlists-panel__cards {
      gap: 1rem;
    }
    .playlists-panel__card {
      padding: 1rem 0.95rem 1.05rem;
    }
    .playlists-panel__header {
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: 0.9rem;
    }
    h2 {
      font-size: 1.125rem;
    }
    .playlists-panel__meta {
      font-size: 0.6875rem;
    }
    .playlists-panel__info {
      padding-right: 0;
    }
    .playlists-panel__description {
      margin-top: 0.6rem;
      font-size: 0.8125rem;
    }
    button[data-export] {
      top: 0.85rem;
      right: 0.85rem;
    }
  }
  @media (max-width: 360px) {
    .playlists-panel__header {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 0.7rem;
    }
    .playlists-panel__card {
      padding: 0.9rem 0.8rem 1rem;
    }
  }
</style>
