---
import playlists from '~/data/playlists.json'
import { withBasePath } from '~/utils/path'

const config = playlists.map((entry) => ({
  ...entry,
  cover: withBasePath(entry.cover),
}))
---

<playlist-panel
  class="playlists-panel"
  data-config={JSON.stringify(config)}
  data-state="loading"
  role="region"
  aria-label="歌单收藏"
  aria-busy="true"
>
  <div class="playlists-panel__interactive">
    <div class="playlists-panel__cards">
      {config.map((entry) => (
        <article
          class="playlists-panel__card"
          data-playlist-id={entry.id}
          aria-labelledby={`playlist-title-${entry.id}`}
        >
          <div data-details hidden>
            <div class="playlists-panel__header">
              <img
                class="playlists-panel__cover"
                data-cover
                src={entry.cover}
                width="144"
                height="144"
                alt=""
                loading="lazy"
              />
              <div class="playlists-panel__info">
                <span class="playlists-panel__source">
                  {entry.platform === 'qq' ? 'QQ 音乐' : '网易云音乐'}
                </span>
                <h2 id={`playlist-title-${entry.id}`}>
                  <a
                    data-title
                    href={entry.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {entry.title || entry.id}
                  </a>
                </h2>
                <p class="playlists-panel__meta" data-meta hidden>
                  <span>
                    by <span data-author />
                  </span>
                  <span class="playlists-panel__count" data-count />
                </p>
              </div>
            </div>
            <p class="playlists-panel__description" data-description hidden />
          </div>

          <div data-skeleton aria-hidden="true">
            <div class="playlists-panel__header">
              <div class="playlists-panel__cover playlists-panel__bone" />
              <div class="playlists-panel__info playlists-panel__skeleton-info">
                <span class="playlists-panel__bone" />
                <span class="playlists-panel__bone" />
                <span class="playlists-panel__bone" />
              </div>
            </div>
            <div class="playlists-panel__skeleton-description">
              <span class="playlists-panel__bone" />
              <span class="playlists-panel__bone" />
            </div>
          </div>

          <div class="playlists-panel__actions">
            <p class="playlists-panel__note" data-note hidden />
            <button type="button" data-export disabled>
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path
                  d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              导出文本
            </button>
          </div>
        </article>
      ))}
    </div>
    <div class="playlists-panel__footer">
      <p
        class="playlists-panel__status"
        data-status
        role="status"
        aria-live="polite"
      >
        正在获取歌单…
      </p>
      <time data-updated hidden />
    </div>
  </div>

  <noscript>
    <style>
      .playlists-panel__interactive {
        display: none;
      }
    </style>
    <p class="playlists-panel__fallback">
      启用 JavaScript 后可查看歌单详情并导出文本，也可以前往原歌单查看：
      {config.map((entry) => (
        <a href={entry.url} target="_blank" rel="noopener noreferrer">
          {entry.title || entry.id}
        </a>
      ))}
    </p>
  </noscript>
</playlist-panel>

<script>
  import { mountPlaylists } from '~/utils/playlists-ui'

  class PlaylistPanel extends HTMLElement {
    private cleanup?: () => void
    connectedCallback() {
      this.cleanup = mountPlaylists(this)
    }
    disconnectedCallback() {
      this.cleanup?.()
    }
  }
  if (!customElements.get('playlist-panel'))
    customElements.define('playlist-panel', PlaylistPanel)
</script>

<style>
  .playlists-panel {
    --playlist-muted: color-mix(in srgb, var(--c-text) 62%, var(--c-bg));
    --playlist-line: color-mix(in srgb, var(--c-text) 12%, var(--c-bg));
    display: block;
    min-width: 0;
    margin-top: 2rem;
    font-size: 0.875rem;
  }
  [hidden] {
    display: none !important;
  }
  .playlists-panel__cards {
    display: grid;
    gap: 1.25rem;
  }
  .playlists-panel__card {
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--playlist-line);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--c-text) 2%, var(--c-bg));
  }
  .playlists-panel__header {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .playlists-panel__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--c-text) 6%, var(--c-bg));
  }
  .playlists-panel__info {
    min-width: 0;
    padding-top: 0.125rem;
  }
  .playlists-panel__source {
    display: block;
    color: var(--playlist-muted);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
  }
  h2 {
    margin: 0.25rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  h2 a {
    color: color-mix(in srgb, var(--c-text) 88%, transparent);
    border-bottom: 1px solid transparent;
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }
  h2 a:hover,
  h2 a:focus-visible {
    color: var(--c-text);
    border-bottom-color: color-mix(in srgb, var(--c-text) 38%, transparent);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .playlists-panel__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: 1.5rem 0 0;
    color: var(--playlist-muted);
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .playlists-panel__count {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .playlists-panel__description {
    margin: 1.25rem 0 0;
    color: var(--playlist-muted);
    font-size: 0.875rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }
  .playlists-panel__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1rem;
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--playlist-line);
    border-radius: 0.375rem;
    color: var(--playlist-muted);
    background: transparent;
    font: inherit;
    font-size: 0.75rem;
    white-space: nowrap;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }
  button:enabled {
    cursor: pointer;
  }
  button:enabled:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }
  button:disabled {
    opacity: 0.5;
  }
  .playlists-panel__note {
    flex: 1 1 12rem;
    margin: 0 auto 0 0;
    color: var(--playlist-muted);
    font-size: 0.75rem;
    line-height: 1.8;
  }
  .playlists-panel__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1rem;
    padding-top: 0.75rem;
    color: var(--playlist-muted);
    font-size: 0.6875rem;
    line-height: 1.8;
  }
  .playlists-panel__status {
    margin: 0;
  }
  [data-state='ready'] .playlists-panel__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  [data-state='failed'] .playlists-panel__footer {
    justify-content: flex-start;
    font-size: 0.8125rem;
  }
  .playlists-panel__fallback {
    color: var(--playlist-muted);
    line-height: 1.8;
    font-size: 0.875rem;
  }
  .playlists-panel__fallback a {
    display: inline-block;
    margin-inline-end: 0.75rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .playlists-panel__bone {
    display: block;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--c-text) 7%, var(--c-bg));
    animation: playlist-pulse 1.8s ease-in-out infinite;
  }
  .playlists-panel__cover.playlists-panel__bone {
    border-radius: 0.6rem;
  }
  .playlists-panel__skeleton-info span {
    height: 0.75rem;
    width: 32%;
    margin-top: 0.25rem;
  }
  .playlists-panel__skeleton-info span:nth-child(2) {
    height: 1.5rem;
    width: 90%;
    margin-top: 0.5rem;
  }
  .playlists-panel__skeleton-info span:last-child {
    width: 65%;
    margin-top: 1.75rem;
  }
  .playlists-panel__skeleton-description {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .playlists-panel__skeleton-description span {
    height: 0.875rem;
  }
  .playlists-panel__skeleton-description span:last-child {
    width: 60%;
  }
  @keyframes playlist-pulse {
    50% {
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .playlists-panel__bone {
      animation: none;
    }
    a,
    button {
      transition: none;
    }
  }
  @media (max-width: 600px) {
    .playlists-panel__card {
      padding: 1rem;
    }
    .playlists-panel__header {
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: 1rem;
    }
    h2 {
      font-size: 1.125rem;
    }
    .playlists-panel__meta {
      gap: 0.3rem 0.75rem;
      margin-top: 1rem;
      font-size: 0.75rem;
    }
    .playlists-panel__description {
      margin-top: 1rem;
      font-size: 0.8125rem;
    }
  }
  @media (max-width: 360px) {
    .playlists-panel__header {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>
