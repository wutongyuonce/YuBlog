---
import playlists from '~/data/playlists.json'
import { withBasePath } from '~/utils/path'

const coverModules = import.meta.glob<string>(
  '/src/content/interests/playlists/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, query: '?url', import: 'default' }
)

/** `cover` 写封面文件夹内的文件名；缺失时构建失败，不静默给空图。 */
const coverPath = (file: string): string => {
  const url = coverModules[`/src/content/interests/playlists/${file}`]
  if (!url)
    throw new Error(
      `Playlist: 找不到封面 src/content/interests/playlists/${file}`
    )
  return withBasePath(url)
}

const config = playlists.map((entry) => ({
  ...entry,
  cover: coverPath(entry.cover),
}))

/** 运行时只需要身份字段与链接；封面由构建期决定，不进接口契约。 */
const runtimeConfig = config.map(({ cover, ...entry }) => entry)
---

<playlist-panel
  class="playlists-panel"
  data-config={JSON.stringify(runtimeConfig)}
  data-state="loading"
  role="region"
  aria-label="歌单收藏"
  aria-busy="true"
>
  <div class="playlists-panel__interactive">
    <div class="playlists-panel__cards">
      {config.map((entry, index) => (
        <article
          class="playlists-panel__card"
          data-playlist-id={entry.id}
          aria-labelledby={`playlist-title-${entry.id}`}
        >
          <div class="playlists-panel__media">
            <img
              class="playlists-panel__cover"
              data-cover
              src={entry.cover}
              width="1200"
              height="1200"
              alt=""
              loading={index < 2 ? 'eager' : 'lazy'}
            />
            <span class="playlists-panel__blend" aria-hidden="true" />
          </div>

          <div class="playlists-panel__panel" data-details>
            <p class="playlists-panel__meta">
              <span class="playlists-panel__source">
                {entry.platform === 'qq' ? 'QQ 音乐' : '网易云音乐'}
              </span>
              <span class="playlists-panel__meta-item" data-meta hidden>
                <span aria-hidden="true">·</span>
                <span data-author />
              </span>
              <span class="playlists-panel__meta-item playlists-panel__count">
                <span aria-hidden="true">·</span>
                <span data-count>—</span>
                <span class="playlists-panel__unit">首</span>
              </span>
            </p>

            <h2 id={`playlist-title-${entry.id}`}>
              <a
                data-title
                href={entry.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {entry.title || entry.id}
              </a>
            </h2>

            <p class="playlists-panel__description" data-description hidden />

            <p class="playlists-panel__note" data-note hidden />

            <div class="playlists-panel__actions">
              <a
                class="playlists-panel__play"
                href={entry.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`播放${entry.title || entry.id}`}
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M7 4.5v15l12-7.5-12-7.5Z" />
                </svg>
                播放
              </a>
              <button type="button" data-export disabled>
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 3v12m-5-5 5 5 5-5M5 16v3a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3" />
                </svg>
                导出歌单
              </button>
            </div>
          </div>

          <div
            class="playlists-panel__panel"
            data-skeleton
            hidden
            aria-hidden="true"
          >
            <span class="playlists-panel__bone playlists-panel__bone--meta" />
            <span class="playlists-panel__bone playlists-panel__bone--title" />
            <span class="playlists-panel__bone playlists-panel__bone--desc" />
            <span class="playlists-panel__bone playlists-panel__bone--desc-short" />
          </div>
        </article>
      ))}
    </div>
    <div class="playlists-panel__footer">
      <p
        class="playlists-panel__status"
        data-status
        role="status"
        aria-live="polite"
      >
        正在获取歌单…
      </p>
      <time data-updated hidden />
    </div>
  </div>

  <noscript>
    <style>
      .playlists-panel__interactive {
        display: none;
      }
    </style>
    <p class="playlists-panel__fallback">
      启用 JavaScript 后可查看歌单详情并导出歌单，也可以前往原歌单查看：
      {config.map((entry) => (
        <a href={entry.url} target="_blank" rel="noopener noreferrer">
          {entry.title || entry.id}
        </a>
      ))}
    </p>
  </noscript>
</playlist-panel>

<script>
  import { mountPlaylists } from '~/utils/playlists-ui'

  class PlaylistPanel extends HTMLElement {
    private cleanup?: () => void
    connectedCallback() {
      this.cleanup = mountPlaylists(this)
    }
    disconnectedCallback() {
      this.cleanup?.()
    }
  }
  if (!customElements.get('playlist-panel'))
    customElements.define('playlist-panel', PlaylistPanel)
</script>

<style>
  .playlists-panel {
    --playlist-poster: oklch(0.975 0.004 75);
    --playlist-poster-ink: oklch(0.25 0.01 35);
    --playlist-poster-muted: oklch(0.48 0.01 35);
    --playlist-play-bg: oklch(0.25 0.01 35);
    --playlist-play-bg-hover: oklch(0.33 0.01 35);
    --playlist-play-ink: oklch(0.98 0 0);
    --playlist-page-muted: color-mix(in srgb, var(--c-text) 60%, var(--c-bg));
    display: block;
    min-width: 0;
    margin-top: 2rem;
    font-size: 0.875rem;
  }
  [hidden] {
    display: none !important;
  }
  :global(.dark) .playlists-panel {
    --playlist-poster: oklch(0.235 0.012 20);
    --playlist-poster-ink: oklch(0.97 0.005 20);
    --playlist-poster-muted: oklch(0.8 0.015 20);
    --playlist-play-bg: oklch(0.98 0 0);
    --playlist-play-bg-hover: oklch(0.92 0.005 20);
    --playlist-play-ink: oklch(0.16 0.01 20);
  }
  .playlists-panel__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .playlists-panel__card {
    display: grid;
    grid-template-columns: 8.25rem minmax(0, 1fr);
    min-height: 7.5rem;
    overflow: hidden;
    border-radius: 0.875rem;
    color: var(--playlist-poster-ink);
    background: var(--playlist-poster);
  }
  .playlists-panel__media {
    position: relative;
  }
  .playlists-panel__cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .playlists-panel__blend {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent 40%,
      color-mix(in srgb, var(--playlist-poster) 78%, transparent) 78%,
      var(--playlist-poster) 100%
    );
  }
  .playlists-panel__panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 0.875rem 0.875rem 0.875rem 0.25rem;
  }
  .playlists-panel__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.375rem;
    margin: 0;
    color: var(--playlist-poster-muted);
    font-size: 0.6875rem;
    line-height: 1.5;
  }
  .playlists-panel__source {
    color: var(--playlist-poster-ink);
    letter-spacing: 0.04em;
  }
  .playlists-panel__meta-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .playlists-panel__unit {
    font-size: 0.625rem;
  }
  h2 {
    margin: 0.375rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.4;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  h2 a {
    color: inherit;
    text-decoration: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  /* 标题族：docs/design/site.md#visuals */
  h2 a:is(:hover, :focus-visible) {
    color: var(--accent);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
  }
  .playlists-panel__description {
    margin: 0.5rem 0 0;
    color: var(--playlist-poster-muted);
    font-size: 0.75rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }
  .playlists-panel__note {
    margin: 0.375rem 0 0;
    color: var(--playlist-poster-muted);
    font-size: 0.6875rem;
    line-height: 1.6;
  }
  .playlists-panel__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .playlists-panel__play,
  button[data-export] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3125rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.5625rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }
  .playlists-panel__actions svg {
    flex: none;
  }
  .playlists-panel__play {
    min-width: 3.5rem;
    color: var(--playlist-play-ink);
    background: var(--playlist-play-bg);
    font-weight: 600;
  }
  button[data-export] {
    border-color: color-mix(
      in srgb,
      var(--playlist-poster-ink) 22%,
      transparent
    );
    color: var(--playlist-poster-ink);
    background: color-mix(in srgb, var(--playlist-poster-ink) 6%, transparent);
  }
  button:enabled {
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.45;
  }
  @media (hover: hover) and (pointer: fine) {
    .playlists-panel__play:hover {
      background: var(--playlist-play-bg-hover);
    }
    button:enabled:hover {
      border-color: color-mix(
        in srgb,
        var(--playlist-poster-ink) 45%,
        transparent
      );
      background: color-mix(
        in srgb,
        var(--playlist-poster-ink) 12%,
        transparent
      );
    }
  }
  .playlists-panel__card
    :is(.playlists-panel__play, button, h2 a):focus-visible {
    outline: 2px solid
      color-mix(in srgb, var(--playlist-poster-ink) 75%, transparent);
    outline-offset: 3px;
  }
  .playlists-panel__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1rem;
    padding-top: 0.5rem;
    color: var(--playlist-page-muted);
    font-size: 0.625rem;
    line-height: 1.8;
  }
  .playlists-panel__status {
    margin: 0;
  }
  [data-state='ready'] .playlists-panel__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  [data-state='failed'] .playlists-panel__footer {
    justify-content: flex-start;
    font-size: 0.8125rem;
  }
  [data-state='failed'] .playlists-panel__count {
    display: none;
  }
  .playlists-panel__fallback {
    color: var(--playlist-page-muted);
    font-size: 0.875rem;
    line-height: 1.8;
  }
  .playlists-panel__fallback a {
    display: inline-block;
    margin-inline-end: 0.75rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .playlists-panel__bone {
    display: block;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--playlist-poster-ink) 12%, transparent);
    animation: playlist-pulse 1.8s ease-in-out infinite;
  }
  .playlists-panel__bone--meta {
    width: 7rem;
    height: 0.625rem;
  }
  .playlists-panel__bone--title {
    width: 70%;
    height: 1.0625rem;
    margin-top: 0.5rem;
  }
  .playlists-panel__bone--desc,
  .playlists-panel__bone--desc-short {
    width: 92%;
    height: 0.625rem;
    margin-top: 0.375rem;
  }
  .playlists-panel__bone--desc {
    margin-top: 0.625rem;
  }
  .playlists-panel__bone--desc-short {
    width: 64%;
  }
  @keyframes playlist-pulse {
    50% {
      opacity: 0.45;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .playlists-panel__bone {
      animation: none;
    }
    .playlists-panel__play,
    button {
      transition: none;
    }
  }
  @media (max-width: 768px) {
    .playlists-panel__cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
    /* 窄屏沿用桌面横卡：单列方形封面会让一张卡占掉半屏，8 份要滑近六屏。 */
    .playlists-panel__card {
      grid-template-columns: 7.25rem minmax(0, 1fr);
      min-height: 7rem;
    }
    .playlists-panel__blend {
      background: linear-gradient(
        to right,
        transparent 34%,
        color-mix(in srgb, var(--playlist-poster) 82%, transparent) 74%,
        var(--playlist-poster) 100%
      );
    }
    .playlists-panel__panel {
      padding: 0.75rem 0.875rem 0.75rem 0.1875rem;
    }
    h2 {
      font-size: 1.0625rem;
    }
    .playlists-panel__meta {
      font-size: 0.6875rem;
    }
    /* 窄屏横卡放不下完整简介，只留一行，不撑高卡片。 */
    .playlists-panel__description {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 1;
      overflow: hidden;
      margin-top: 0.25rem;
      font-size: 0.6875rem;
      line-height: 1.5;
    }
    .playlists-panel__note {
      margin-top: 0.25rem;
      font-size: 0.625rem;
      line-height: 1.4;
    }
    .playlists-panel__actions {
      margin-top: 0.5rem;
      gap: 0.375rem;
    }
    .playlists-panel__play,
    button[data-export] {
      min-height: 2.25rem;
      padding: 0.25rem 0.5625rem;
      font-size: 0.75rem;
    }
  }
</style>
