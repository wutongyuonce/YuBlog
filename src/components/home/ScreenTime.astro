---
/*
 * 屏幕时间只在运行时取得：这里只输出加载态骨架、空的消息位与无脚本提示，
 * 数据与失败文案都由 `~/utils/screen-time-view.js` 在校验接口响应后填入。
 * `aria-busy` 也由脚本设置：无脚本时没有东西在加载，不该标成忙碌。
 */
---

<section
  class="screen-time"
  aria-labelledby="screen-time-title"
  data-screen-time
  data-state="loading"
>
  <header class="home-section-header">
    <h2 id="screen-time-title">屏幕时间</h2>
    <a
      href="https://activitywatch.net/"
      target="_blank"
      rel="noopener noreferrer"
    >
      ActivityWatch ↗
    </a>
  </header>
  <div class="screen-time__body" data-screen-time-body>
    <div class="screen-time__summary" aria-hidden="true">
      <p class="screen-time__label">最近活跃</p>
      <p class="screen-time__value">—</p>
      <p class="screen-time__note">仅统计电脑前的活跃时间</p>
    </div>
    <div class="screen-time__week" aria-hidden="true">
      <p class="screen-time__label">近 7 天（小时）</p>
      <ol class="screen-time__chart">
        {Array.from({ length: 7 }, () => (
          <li>
            <span class="screen-time__skeleton-day">
              <span class="screen-time__hours screen-time__skeleton-text">
                0.0
              </span>
              <span class="screen-time__column">
                <span
                  class="screen-time__bar screen-time__skeleton-bar"
                  aria-hidden="true"
                />
              </span>
              <span class="screen-time__skeleton-text">00/00</span>
            </span>
          </li>
        ))}
      </ol>
      <ul class="screen-time__legend">
        {Array.from({ length: 6 }, () => (
          <li>
            <span class="screen-time__swatch" aria-hidden="true" />
            <span class="screen-time__skeleton-text">应用名称</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="screen-time__message" data-screen-time-message hidden></p>
  <p class="screen-time__updated">
    更新于 <time data-screen-time-time>—</time>（北京时间）；— 表示暂无记录
  </p>
  <noscript>
    <p class="screen-time__message">
      屏幕时间由本机同步后按需加载，需要启用 JavaScript。
    </p>
  </noscript>
</section>

<style is:global>
  /* 必须是全局作用域：交互与图表在运行时插入，拿不到 Astro 的 scoped 属性。 */
  .screen-time {
    --screen-app-0: var(--accent);
    --screen-app-1: #567f9c;
    --screen-app-2: #6a8860;
    --screen-app-3: #b58a48;
    --screen-app-4: #548e8a;
    --screen-app-5: #858585;
    --screen-app-6: color-mix(in srgb, var(--c-text) 20%, var(--c-bg));
    margin-top: 3rem;
  }
  .dark .screen-time {
    --screen-app-1: #8aadc5;
    --screen-app-2: #9ab58e;
    --screen-app-3: #d9b47b;
    --screen-app-4: #8dbdb9;
    --screen-app-5: #aaa;
  }
  .screen-time__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    align-items: center;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .screen-time p {
    margin: 0;
  }
  .screen-time__label,
  .screen-time__note,
  .screen-time__updated,
  .screen-time__percent,
  .screen-time__message {
    color: color-mix(in srgb, var(--c-text) 65%, var(--c-bg));
    font-size: 0.75rem;
  }
  .screen-time .screen-time__value {
    margin: 0.5rem 0 0.75rem;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
  }
  .screen-time__week {
    position: relative;
    min-width: 0;
  }
  .screen-time__chart {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }
  .screen-time__day summary,
  .screen-time__skeleton-day {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .screen-time__day summary {
    list-style: none;
    cursor: pointer;
  }
  .screen-time__day summary::-webkit-details-marker {
    display: none;
  }
  .screen-time__column {
    display: flex;
    align-items: end;
    width: 100%;
    height: 7rem;
    background: color-mix(in srgb, var(--c-text) 4%, var(--c-bg));
  }
  .screen-time__bar {
    display: flex;
    flex-direction: column-reverse;
    width: 100%;
  }
  .screen-time__segment {
    display: block;
    flex: none;
    width: 100%;
    background: var(--app-color);
  }
  /* 骨架保留与真实柱子相同的布局，只提示「正在加载」，不暗示任何数值。 */
  .screen-time__skeleton-text {
    visibility: hidden;
  }
  .screen-time__skeleton-bar {
    height: 30%;
    background: color-mix(in srgb, var(--c-text) 10%, var(--c-bg));
    animation: screen-time-pulse 1.6s ease-in-out infinite;
  }
  @keyframes screen-time-pulse {
    50% {
      opacity: 0.45;
    }
  }
  .screen-time__day:is([open], :hover) .screen-time__column {
    outline: 1px solid color-mix(in srgb, var(--c-text) 35%, var(--c-bg));
    outline-offset: 3px;
  }
  .screen-time__day time {
    color: color-mix(in srgb, var(--c-text) 65%, var(--c-bg));
  }
  .screen-time__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.85rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.6875rem;
  }
  .screen-time__legend li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    max-width: 100%;
  }
  .screen-time__legend li > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .screen-time__swatch {
    display: inline-block;
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--app-color);
  }
  .screen-time__detail {
    position: absolute;
    z-index: 100;
    bottom: calc(100% + 12px);
    left: 0;
    width: min(350px, calc(100vw - 32px));
    max-height: min(360px, calc(100dvh - 32px));
    overflow: auto;
    overscroll-behavior: contain;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--c-text) 12%, var(--c-bg));
    background: var(--c-bg);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--c-text) 8%, transparent);
    color: var(--c-text);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  [data-screen-bound] .screen-time__detail {
    position: fixed;
    bottom: auto;
  }
  .screen-time__detail h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 400;
  }
  .screen-time .screen-time__detail-total {
    margin: 0.4rem 0 0.85rem;
    color: color-mix(in srgb, var(--c-text) 65%, var(--c-bg));
  }
  .screen-time__apps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .screen-time__apps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto 3.25rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.25rem;
  }
  .screen-time__app-name {
    overflow-wrap: anywhere;
    line-height: 1.5;
  }
  .screen-time__percent {
    text-align: right;
  }
  .screen-time__apps li[data-highlight] {
    background: color-mix(in srgb, var(--app-color) 14%, var(--c-bg));
  }
  .screen-time .screen-time__updated {
    margin-top: 1rem;
    line-height: 1.8;
  }
  .screen-time .screen-time__message {
    margin-top: 0.75rem;
    line-height: 1.8;
  }
  @media (prefers-reduced-motion: reduce) {
    .screen-time__skeleton-bar {
      animation: none;
    }
  }
  @media (max-width: 540px) {
    .screen-time__body {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .screen-time__chart {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  import { screenTimeDayLabel } from '~/utils/screen-time.js'
  import {
    parseScreenTimePayload,
    renderScreenTime,
  } from '~/utils/screen-time-view.js'

  /** 与 Vercel 上的函数路径一致；接口不受站点 base 影响。 */
  const ENDPOINT = '/api/screen-time'

  let request: AbortController | undefined
  let timer: ReturnType<typeof setInterval> | undefined

  const updateDay = () => {
    document
      .querySelectorAll<HTMLElement>('[data-screen-time-day]')
      .forEach((label) => {
        label.textContent = screenTimeDayLabel(label.dataset.screenTimeDay!)
      })
  }

  const bindChart = (root: HTMLElement) => {
    if (root.hasAttribute('data-screen-bound')) return
    root.setAttribute('data-screen-bound', '')
    const controller = new AbortController()
    const { signal } = controller
    const days = [
      ...root.querySelectorAll<HTMLDetailsElement>('[data-screen-day]'),
    ]
    let hideTimer = 0
    const cancelHide = () => window.clearTimeout(hideTimer)
    const close = () => {
      cancelHide()
      days.forEach((day) => {
        day.open = false
      })
    }
    const place = (day: HTMLDetailsElement) => {
      const panel = day.querySelector<HTMLElement>('.screen-time__detail')!
      panel.style.left = '16px'
      panel.style.top = '16px'
      const anchor = day.querySelector('summary')!.getBoundingClientRect()
      const box = panel.getBoundingClientRect()
      const left = Math.max(
        16,
        Math.min(
          anchor.left + anchor.width / 2 - box.width / 2,
          innerWidth - box.width - 16
        )
      )
      const top = anchor.top - box.height - 12
      panel.style.left = `${left}px`
      panel.style.top = `${Math.max(16, Math.min(top >= 16 ? top : anchor.bottom + 12, innerHeight - box.height - 16))}px`
    }
    const open = (day: HTMLDetailsElement) => {
      cancelHide()
      days.forEach((other) => {
        other.open = other === day
      })
      place(day)
    }
    for (const day of days) {
      day.querySelector('summary')!.addEventListener(
        'click',
        (event) => {
          event.preventDefault()
          if (day.open) day.open = false
          else open(day)
        },
        { signal }
      )
      day.addEventListener(
        'toggle',
        () => {
          if (day.open) open(day)
        },
        { signal }
      )
      day.addEventListener(
        'pointerenter',
        (event) => {
          if (event.pointerType === 'mouse') open(day)
        },
        { signal }
      )
      day.addEventListener(
        'pointerleave',
        () => {
          cancelHide()
          hideTimer = window.setTimeout(() => {
            if (!day.contains(document.activeElement)) day.open = false
          }, 250)
        },
        { signal }
      )
      day.addEventListener(
        'focusin',
        () => {
          if (day.querySelector('summary')!.matches(':focus-visible')) open(day)
        },
        { signal }
      )
      day.addEventListener(
        'focusout',
        (event) => {
          if (
            !(event.relatedTarget instanceof Node) ||
            !day.contains(event.relatedTarget)
          )
            day.open = false
        },
        { signal }
      )
      day.querySelector('summary')!.addEventListener(
        'pointermove',
        (event) => {
          const slot =
            event.target instanceof Element
              ? event.target.closest<HTMLElement>('[data-screen-slot]')?.dataset
                  .screenSlot
              : undefined
          day
            .querySelectorAll<HTMLElement>('[data-screen-app]')
            .forEach((row) =>
              row.toggleAttribute(
                'data-highlight',
                slot !== undefined && row.dataset.screenApp === slot
              )
            )
        },
        { signal }
      )
    }
    document.addEventListener(
      'pointerdown',
      (event) => {
        if (
          event.target instanceof Node &&
          !days.some((day) => day.open && day.contains(event.target as Node))
        )
          close()
      },
      { signal }
    )
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape') return
        const focused = days.find((day) =>
          day
            .querySelector('.screen-time__detail')
            ?.contains(document.activeElement)
        )
        focused?.querySelector('summary')?.focus({ preventScroll: true })
        close()
      },
      { signal }
    )
    window.addEventListener(
      'scroll',
      (event) => {
        if (
          event.target instanceof Element &&
          event.target.closest('.screen-time__detail')
        )
          return
        const focused = days.find(
          (day) => day.open && day.contains(document.activeElement)
        )
        if (focused) {
          const rect = focused.getBoundingClientRect()
          if (rect.bottom > 0 && rect.top < innerHeight) {
            place(focused)
            return
          }
        }
        close()
      },
      { signal, capture: true }
    )
    window.addEventListener(
      'resize',
      () => days.filter((day) => day.open).forEach(place),
      { signal }
    )
    document.addEventListener(
      'astro:before-swap',
      () => {
        close()
        controller.abort()
      },
      { once: true, signal }
    )
  }

  const fill = async (root: HTMLElement, signal: AbortSignal) => {
    let snapshot = null
    try {
      const response = await fetch(ENDPOINT, {
        signal,
        headers: { accept: 'application/json' },
      })
      if (response.ok) snapshot = parseScreenTimePayload(await response.json())
    } catch (error) {
      if (signal.aborted) return
      // 网络错误、超时和非 JSON 响应都走同一套失败状态。
      console.warn('Screen time request failed', error)
    }
    if (signal.aborted || !root.isConnected) return
    renderScreenTime(root, snapshot)
    if (!snapshot) return
    bindChart(root)
    updateDay()
    timer = setInterval(updateDay, 60_000)
  }

  const start = () => {
    const root = document.querySelector<HTMLElement>('[data-screen-time]')
    if (!root || root.dataset.state !== 'loading' || request) return
    clearInterval(timer)
    root.setAttribute('aria-busy', 'true')
    const current = new AbortController()
    request = current
    void fill(root, current.signal).finally(() => {
      if (request === current) request = undefined
    })
  }

  document.addEventListener('astro:before-swap', () => {
    request?.abort()
    request = undefined
    clearInterval(timer)
  })
  document.addEventListener('astro:page-load', start)
  document.addEventListener('visibilitychange', updateDay)
  start()
</script>
