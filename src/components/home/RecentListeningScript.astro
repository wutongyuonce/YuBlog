<!-- Render before ClientRouter so listening does not queue behind its module dependencies. -->
<script>
  import {
    parseListeningPayload,
    parseNowPlayingPayload,
    renderListening,
    renderNowPlaying,
  } from '~/utils/recent-listening'

  /** 与 Vercel 上的函数路径一致；接口不受站点 base 影响。 */
  const ENDPOINT = '/api/lastfm'
  const NOW_ENDPOINT = '/api/lastfm-now'
  /** 正在播放每分钟刷新一次；接口自身有 30 秒 CDN 缓存。 */
  const NOW_INTERVAL = 60_000

  let request: AbortController | undefined
  let nowTimer: ReturnType<typeof setInterval> | undefined

  const getJson = async (url: string, signal: AbortSignal) => {
    const response = await fetch(url, {
      signal,
      headers: { accept: 'application/json' },
    })
    return response.ok ? response.json() : null
  }

  const fill = async (root: HTMLElement, signal: AbortSignal) => {
    let snapshot = null
    try {
      snapshot = parseListeningPayload(await getJson(ENDPOINT, signal))
    } catch (error) {
      if (signal.aborted) return
      // 网络错误、超时和非 JSON 响应都走同一套失败状态。
      console.warn('Last.fm listening request failed', error)
    }
    if (signal.aborted || !root.isConnected) return
    renderListening(root, snapshot, root.dataset.period)
    if (!snapshot) return
    // 切换时段只重绘同一份快照，不再请求接口。
    root.addEventListener(
      'click',
      (event) => {
        const button = (event.target as Element).closest<HTMLElement>(
          '[data-listening-period]'
        )
        const period = button?.dataset.listeningPeriod
        if (period && period !== root.dataset.period)
          renderListening(root, snapshot, period)
      },
      { signal }
    )
  }

  /** 轮询序号：只有最新一次轮询的结果能写入，迟到的旧响应直接丢弃。 */
  let nowSequence = 0

  const fillNow = async (block: HTMLElement, signal: AbortSignal) => {
    const sequence = ++nowSequence
    let data = null
    try {
      data = parseNowPlayingPayload(await getJson(NOW_ENDPOINT, signal))
    } catch (error) {
      if (signal.aborted) return
      console.warn('Last.fm now-playing request failed', error)
    }
    if (signal.aborted || sequence !== nowSequence || !block.isConnected) return
    renderNowPlaying(block, data)
  }

  const stop = () => {
    request?.abort()
    request = undefined
    clearInterval(nowTimer)
    nowTimer = undefined
  }

  const load = () => {
    const root = document.querySelector<HTMLElement>('[data-listening]')
    if (!root || root.dataset.state !== 'loading' || request) return
    const current = new AbortController()
    request = current
    const block = root.querySelector<HTMLElement>('[data-now-playing]')
    if (block) {
      void fillNow(block, current.signal)
      // 只在页面可见时轮询；隐藏的标签页不打接口。
      nowTimer = setInterval(() => {
        if (document.visibilityState === 'visible')
          void fillNow(block, current.signal)
      }, NOW_INTERVAL)
    }
    void fill(root, current.signal)
  }

  document.addEventListener('astro:before-swap', stop)
  document.addEventListener('astro:page-load', load)
  load()
</script>
