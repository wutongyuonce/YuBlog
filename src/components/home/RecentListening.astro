---
/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- 轨道本身不是滚动容器；聚焦它是为了暂停循环。 */
/* eslint-disable astro/jsx-a11y/anchor-has-content, astro/jsx-a11y/anchor-is-valid -- 卡片模板的文字与链接由脚本按接口数据填入。 */
import { LASTFM_USER, lastfmProfileUrl } from '~/utils/lastfm.mjs'

const profileUrl = lastfmProfileUrl(LASTFM_USER)
---

<!--
  听歌数据只在运行时取得，所以这里只输出加载态骨架卡、卡片模板和失败说明；
  统计、卡片和更新时间都由 `~/utils/recent-listening` 在校验响应后填入。
-->
<section
  class="recent-listening"
  aria-labelledby="recent-listening-title"
  aria-busy="true"
  data-listening
  data-state="loading"
>
  <header class="home-section-header">
    <h2 id="recent-listening-title">最近在听 TOP10</h2>
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">
      Last.fm ↗
    </a>
  </header>
  <div class="recent-listening__stats" aria-label="听歌统计">
    <span>
      过去 7 天 <strong data-listening-stat>—</strong> 次
    </span>
    <span>
      累计 <strong data-listening-stat>—</strong> 次
    </span>
    <span>
      常听歌手{' '}
      <strong data-listening-stat class="recent-listening__artist">
        —
      </strong>
    </span>
  </div>
  <div class="prose markdown-content recent-listening__body">
    <div
      class="media-cards media-cards--rail media-cards--auto"
      tabindex="0"
      role="region"
      aria-label="过去 7 天常听歌曲 TOP 10"
    >
      <div class="media-cards__track" role="list" data-listening-track>
        {Array.from({ length: 10 }, () => (
          <article
            class="recent-listening__skeleton"
            aria-hidden="true"
            data-listening-skeleton
          >
            <div class="recent-listening__skeleton-cover"></div>
            <div class="recent-listening__skeleton-body">
              <span class="recent-listening__skeleton-line"></span>
              <span class="recent-listening__skeleton-line recent-listening__skeleton-line--meta"></span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
  <p class="recent-listening__message" data-listening-message hidden></p>
  <p class="recent-listening__updated">
    更新于 <time data-listening-time>—</time>（北京时间）
  </p>
  <noscript>
    <p class="recent-listening__message">
      听歌数据由 Last.fm 实时提供，需要启用 JavaScript；也可以直接访问{' '}
      <a href={profileUrl} target="_blank" rel="noopener noreferrer">
        Last.fm 主页
      </a>
      。
    </p>
  </noscript>
  <template data-listening-card>
    <article class="media-card media-card--square" role="listitem">
      <div class="image-view">
        <img
          class="media-card__cover"
          width="300"
          height="300"
          loading="lazy"
          decoding="async"
          alt=""
        />
        <template class="image-view__source">
          <img alt="" />
        </template>
      </div>
      <div class="media-card__body">
        <a
          class="media-card__title"
          target="_blank"
          rel="noopener noreferrer"
        ></a>
        <p class="media-card__meta" tabindex="0"></p>
      </div>
    </article>
  </template>
</section>

<style>
  .recent-listening {
    /* Two title lines, two metadata lines, and their shared gap. */
    --listening-copy-height: calc(3rem + 0.35rem + 2.625rem);
    margin-top: 3rem;
  }
  .recent-listening__stats {
    display: grid;
    grid-template-columns: max-content max-content minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    font-size: 0.75rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--c-text) 65%, var(--c-bg));
  }
  .recent-listening__stats > span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  @media (max-width: 600px) {
    .recent-listening__stats {
      grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
    }
    .recent-listening__stats > :last-child {
      grid-column: 1 / -1;
    }
  }
  .recent-listening__stats strong {
    color: var(--c-text);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  /* 常听歌手名：与写作热力摘要数值同级，仅值用强调色，标签保持 muted。
     选择器需压过 `.recent-listening__stats strong` 的正文色。 */
  .recent-listening__stats strong.recent-listening__artist {
    color: var(--accent);
  }
  .recent-listening__body {
    margin-top: 0.75rem;
  }
  .recent-listening__body .media-cards {
    margin: 0;
    overflow: hidden;
    scroll-snap-type: none;
  }
  /* 远程封面尚未下载时延续骨架底色，避免就绪首帧露出透明空框。 */
  .recent-listening__body .media-card > .image-view {
    background: color-mix(in srgb, var(--c-text) 8%, var(--c-bg));
  }
  .recent-listening__body .media-card__body,
  .recent-listening__skeleton-body {
    height: var(--listening-copy-height);
  }
  .recent-listening__body .media-card__body {
    padding: 0;
    gap: 0.35rem;
  }
  .recent-listening__body .media-card__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  /* 加载态：方卡轨距与真实方卡一致，避免就绪后布局跳动；骨架不参与陈列架循环。 */
  .recent-listening[data-state='loading'] .media-cards--rail {
    --rail-gap: 0.85rem;
    --rail-gaps: 5;
    --rail-visible: 5.5;
  }
  .recent-listening__skeleton {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }
  .recent-listening__skeleton-cover {
    aspect-ratio: 1;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--c-text) 8%, var(--c-bg));
    box-shadow: 0 4px 10px rgb(0 0 0 / 6%);
  }
  .recent-listening__skeleton-body {
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }
  .recent-listening__skeleton-line {
    display: block;
    height: 0.85rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--c-text) 8%, var(--c-bg));
  }
  .recent-listening__skeleton-line--meta {
    width: 72%;
    height: 0.7rem;
  }
  .recent-listening__skeleton-cover,
  .recent-listening__skeleton-line {
    animation: recent-listening-skeleton-pulse 1.4s ease-in-out infinite;
  }
  @keyframes recent-listening-skeleton-pulse {
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .recent-listening__skeleton-cover,
    .recent-listening__skeleton-line {
      animation: none;
    }
  }
  .recent-listening:is([data-state='empty'], [data-state='error'])
    .recent-listening__body {
    display: none;
  }
  .recent-listening__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--c-text) 5%, var(--c-bg));
    color: color-mix(in srgb, var(--c-text) 45%, var(--c-bg));
    font-family: var(--font-heading);
    font-size: 2rem;
  }
  .recent-listening__message,
  .recent-listening__updated {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--c-text) 65%, var(--c-bg));
  }
  /* 无脚本回退：正文族，docs/design/site.md#visuals */
  .recent-listening__message a {
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
    text-underline-offset: 0.2em;
  }
  .recent-listening__message a:is(:hover, :focus-visible) {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
