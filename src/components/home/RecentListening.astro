---
/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- Scroll areas need focus for native keyboard scrolling. */
/* eslint-disable astro/jsx-a11y/anchor-has-content, astro/jsx-a11y/anchor-is-valid -- 卡片模板的文字与链接由脚本按接口数据填入。 */
import { LASTFM_USER, lastfmProfileUrl } from '~/utils/lastfm.mjs'

const profileUrl = lastfmProfileUrl(LASTFM_USER)
---

<!--
  听歌数据只在运行时取得，所以这里只输出骨架、卡片模板和失败说明；
  统计、卡片和更新时间都由 `~/utils/recent-listening` 在校验响应后填入。
-->
<section
  class="recent-listening"
  aria-labelledby="recent-listening-title"
  aria-busy="true"
  data-listening
  data-state="loading"
>
  <header class="home-section-header">
    <h2 id="recent-listening-title">最近在听 Top10</h2>
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">
      Last.fm ↗
    </a>
  </header>
  <div class="recent-listening__stats" aria-label="听歌统计">
    <span>
      过去 7 天 <strong data-listening-stat>—</strong> 次
    </span>
    <span>
      累计 <strong data-listening-stat>—</strong> 次
    </span>
    <span>
      常听歌手{' '}
      <strong data-listening-stat class="recent-listening__artist">
        —
      </strong>
    </span>
  </div>
  <div class="prose markdown-content recent-listening__body">
    <div
      class="media-cards media-cards--rail media-cards--auto"
      tabindex="0"
      role="region"
      aria-label="过去 7 天常听歌曲 Top 10，可左右滚动"
    >
      <div class="media-cards__track" role="list" data-listening-track></div>
    </div>
  </div>
  <p class="recent-listening__message" data-listening-message hidden></p>
  <p class="recent-listening__updated">
    更新于 <time data-listening-time>—</time>（北京时间）
  </p>
  <noscript>
    <p class="recent-listening__message">
      听歌数据由 Last.fm 实时提供，需要启用 JavaScript；也可以直接访问{' '}
      <a href={profileUrl} target="_blank" rel="noopener noreferrer">
        Last.fm 主页
      </a>
      。
    </p>
  </noscript>
  <template data-listening-card>
    <article class="media-card media-card--square" role="listitem">
      <div class="image-view">
        <img
          class="media-card__cover"
          width="300"
          height="300"
          loading="lazy"
          decoding="async"
          alt=""
        />
        <template class="image-view__source">
          <img alt="" />
        </template>
      </div>
      <div class="media-card__body">
        <a
          class="media-card__title"
          target="_blank"
          rel="noopener noreferrer"
        ></a>
        <p class="media-card__meta" tabindex="0"></p>
      </div>
    </article>
  </template>
</section>

<script>
  import {
    parseListeningPayload,
    renderListening,
  } from '~/utils/recent-listening'

  /** 与 Vercel 上的函数路径一致；接口不受站点 base 影响。 */
  const ENDPOINT = '/api/lastfm'

  let request: AbortController | undefined

  const fill = async (root: HTMLElement, signal: AbortSignal) => {
    let snapshot = null
    try {
      const response = await fetch(ENDPOINT, {
        signal,
        headers: { accept: 'application/json' },
      })
      if (response.ok) snapshot = parseListeningPayload(await response.json())
    } catch (error) {
      if (signal.aborted) return
      // 网络错误、超时和非 JSON 响应都走同一套失败状态。
      console.warn('Last.fm listening request failed', error)
    }
    if (signal.aborted || !root.isConnected) return
    renderListening(root, snapshot)
    // 注入的卡片需要重新接管：陈列架重算循环副本，图片查看器补键盘入口。
    document.dispatchEvent(new Event('content:added'))
  }

  const load = () => {
    const root = document.querySelector<HTMLElement>('[data-listening]')
    if (!root || root.dataset.state !== 'loading' || request) return
    request = new AbortController()
    void fill(root, request.signal).finally(() => {
      request = undefined
    })
  }

  document.addEventListener('astro:before-swap', () => {
    request?.abort()
    request = undefined
  })
  document.addEventListener('astro:page-load', load)
  load()
</script>

<style>
  .recent-listening {
    margin-top: 3rem;
  }
  .recent-listening__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    font-size: 0.75rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--c-text) 65%, var(--c-bg));
  }
  .recent-listening__stats strong {
    color: var(--c-text);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  /* 常听歌手名：与写作热力摘要数值同级，仅值用强调色，标签保持 muted。
     选择器需压过 `.recent-listening__stats strong` 的正文色。 */
  .recent-listening__stats strong.recent-listening__artist {
    color: var(--accent);
  }
  .recent-listening__body {
    margin-top: 0.75rem;
  }
  .recent-listening__body .media-cards {
    margin: 0;
  }
  .recent-listening__body .media-card__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  /* 等待接口时占住一张卡片的高度，避免数据到达后页面位移。 */
  .recent-listening[data-state='loading'] .media-cards--rail {
    min-height: 12rem;
  }
  .recent-listening:is([data-state='empty'], [data-state='error'])
    .recent-listening__body {
    display: none;
  }
  .recent-listening__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--c-text) 5%, var(--c-bg));
    color: color-mix(in srgb, var(--c-text) 45%, var(--c-bg));
    font-family: var(--font-heading);
    font-size: 2rem;
  }
  .recent-listening__message,
  .recent-listening__updated {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--c-text) 65%, var(--c-bg));
  }
</style>
