---
import { Image } from 'astro:assets'
import PostMeta from '~/components/base/PostMeta.astro'
import { ARTICLE_COLUMN_WIDTH } from '~/utils/misc'

import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  description: string
  titleImage: ImageMetadata
  titleImageAlt: string
  pubDate: string
}

const { title, description, titleImage, titleImageAlt, pubDate } = Astro.props
---

<section class="post-hero" aria-label={title}>
  <Image
    class="post-hero__image"
    src={titleImage}
    alt={titleImageAlt}
    width={ARTICLE_COLUMN_WIDTH}
    priority
  />
  <div class="post-hero__content">
    <p class="post-hero__title">{title}</p>
    {description && <p class="post-hero__subtitle">{description}</p>}
    <PostMeta
      {pubDate}
      lastModDate={undefined}
      minutesRead={0}
      tags={[]}
      hasSubtitle={!!description}
      variant="hero"
    />
  </div>
</section>

<style>
  .post-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(20rem, 46vw, 28rem);
    border-radius: 0.5rem;
    margin-top: 1.75rem;
    color: #fff;
    background: #050505;
  }

  .post-hero::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.03) 12%,
      rgb(0 0 0 / 0.5) 55%,
      rgb(0 0 0 / 0.92) 100%
    );
    pointer-events: none;
  }

  .post-hero__image {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0 !important;
    border-radius: 0 !important;
    object-fit: cover;
  }

  .post-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .post-hero__title {
    max-width: 100%;
    margin: 0 !important;
    color: inherit !important;
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 3.2vw, 1.8rem);
    font-weight: 400 !important;
    line-height: 1.18;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .post-hero__subtitle {
    max-width: 60ch;
    margin: 0.8rem 0 0 !important;
    color: inherit;
    font-size: 0.875rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    opacity: 0.88;
  }

  @media (max-width: 640px) {
    .post-hero {
      min-height: 22rem;
    }

    .post-hero__content {
      padding: 1.25rem;
    }
  }
</style>
