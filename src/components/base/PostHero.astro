---
import { Image } from 'astro:assets'
import { withBasePath } from '~/utils/path'
import { ARTICLE_COLUMN_WIDTH } from '~/utils/misc'

import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  description: string
  titleImage: ImageMetadata
  titleImageAlt: string
}

const { title, description, titleImage, titleImageAlt } = Astro.props
---

<section class="post-hero" aria-label={title}>
  <Image
    class="post-hero__image"
    src={titleImage}
    alt={titleImageAlt}
    width={ARTICLE_COLUMN_WIDTH}
    priority
  />
  <div class="post-hero__content">
    <div class="post-hero__title-row">
      <img
        class="post-hero__avatar"
        src={withBasePath('/avatar.webp')}
        alt=""
        aria-hidden="true"
        width="40"
        height="40"
      />
      <p class="post-hero__title">{title}</p>
    </div>
    {description && <p class="post-hero__subtitle">{description}</p>}
  </div>
</section>

<style>
  .post-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(20rem, 46vw, 28rem);
    border-radius: 0.5rem;
    margin-top: 1.75rem;
    color: #fff;
    background: #050505;
  }

  .post-hero::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.03) 12%,
      rgb(0 0 0 / 0.5) 55%,
      rgb(0 0 0 / 0.92) 100%
    );
    pointer-events: none;
  }

  .post-hero__image {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0 !important;
    border-radius: 0 !important;
    object-fit: cover;
  }

  .post-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: clamp(1.25rem, 4vw, 2rem);
    padding-bottom: clamp(1.5rem, 4.5vw, 2.35rem);
  }

  .post-hero__title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
  }

  .post-hero__avatar {
    flex-shrink: 0;
    width: 2.5rem !important;
    height: 2.5rem !important;
    margin: 0 !important;
    border: 1px solid currentColor;
    border-radius: 999px !important;
    object-fit: cover;
  }

  .post-hero__title {
    max-width: 100%;
    margin: 0 !important;
    color: inherit !important;
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 3.2vw, 1.8rem);
    font-weight: 400 !important;
    line-height: 1.18;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .post-hero__subtitle {
    max-width: 60ch;
    margin: 1.35rem 0 0 !important;
    color: inherit;
    font-size: 0.875rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    opacity: 0.88;
  }

  @media (max-width: 640px) {
    .post-hero {
      min-height: 22rem;
    }

    .post-hero__content {
      padding: 1.25rem;
      padding-bottom: 1.55rem;
    }

    .post-hero__title-row {
      gap: 0.65rem;
    }

    .post-hero__subtitle {
      margin-top: 1.15rem !important;
    }
  }
</style>
