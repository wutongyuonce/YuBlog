---
import { GISCUS } from '~/config'
import { ensureTrailingSlash } from '~/utils/path'

interface Props {
  title?: string
  description?: string
}
const {
  title = '评论',
  description = '欢迎交流，使用 GitHub 账号登录后即可留言。',
} = Astro.props
const term = ensureTrailingSlash(
  new URL(Astro.url.pathname, Astro.site).pathname
)
const discussionsUrl = `https://github.com/${GISCUS.repo}/discussions`
---

<section
  class="comments"
  aria-labelledby="comments-heading"
  data-pagefind-ignore
>
  <header>
    <h2 id="comments-heading">{title}</h2>
    <p>{description}</p>
    <a href={discussionsUrl} target="_blank" rel="noopener noreferrer">
      在 GitHub Discussions 中查看讨论 ↗
    </a>
  </header>
  <giscus-comments>
    <template>
      <giscus-widget
        id="comments"
        repo={GISCUS.repo}
        repoid={GISCUS.repoId}
        category={GISCUS.category}
        categoryid={GISCUS.categoryId}
        mapping="specific"
        {term}
        strict="1"
        reactionsenabled="1"
        emitmetadata="0"
        inputposition="bottom"
        lang="zh-CN"
      ></giscus-widget>
    </template>
    <noscript>
      启用 JavaScript 后可在此评论，也可以直接前往 GitHub 讨论。
    </noscript>
  </giscus-comments>
</section>

<script>
  import { observeTheme } from '~/utils/theme-observer.js'

  /** Warm the same-origin giscus chunk without mounting the iframe. */
  let modulePrefetch: Promise<unknown> | undefined
  const prefetchModule = () => {
    modulePrefetch ??= import('giscus').catch((error) => {
      modulePrefetch = undefined
      throw error
    })
    return modulePrefetch
  }

  const ensurePreconnect = (href: string) => {
    if (document.head.querySelector(`link[data-giscus-preconnect="${href}"]`)) {
      return
    }
    const link = document.createElement('link')
    link.rel = 'preconnect'
    link.href = href
    link.crossOrigin = 'anonymous'
    link.dataset.giscusPreconnect = href
    document.head.append(link)
  }

  class GiscusComments extends HTMLElement {
    private observer?: IntersectionObserver
    private idleId?: number
    private idleTimer?: ReturnType<typeof setTimeout>
    private cleanupTheme?: () => void
    private loading = false

    connectedCallback() {
      const widget = this.querySelector('giscus-widget')
      if (widget) {
        this.cleanupTheme?.()
        const syncTheme = () => {
          widget.theme = document.documentElement.classList.contains('dark')
            ? 'noborder_dark'
            : 'noborder_light'
        }
        syncTheme()
        this.cleanupTheme = observeTheme(syncTheme)
        return
      }

      // OAuth callbacks must save the session even above the lazy-load boundary.
      if (new URLSearchParams(location.search).has('giscus')) {
        void this.load()
        return
      }

      // Idle: fetch the small Lit widget + TLS to giscus.app; still no iframe / GitHub.
      const warm = () => {
        ensurePreconnect('https://giscus.app')
        void prefetchModule().catch(() => {
          // load() reports failures when comments are needed.
        })
      }
      if ('requestIdleCallback' in window) {
        this.idleId = requestIdleCallback(warm, { timeout: 3500 })
      } else {
        this.idleTimer = setTimeout(warm, 1800)
      }

      // Start the iframe a screen earlier so GitHub work overlaps the last scroll.
      this.observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            this.observer?.disconnect()
            void this.load()
          }
        },
        { rootMargin: '640px 0px' }
      )
      this.observer.observe(this)
    }

    private async load() {
      if (this.loading || this.querySelector('giscus-widget')) return
      this.loading = true
      try {
        ensurePreconnect('https://giscus.app')
        await prefetchModule()
        if (!this.isConnected) return
        const template = this.querySelector('template')!
        const isCallback = new URLSearchParams(location.search).has('giscus')
        const historyState = history.state
        const content = template.content.cloneNode(true) as DocumentFragment
        const widget = content.querySelector('giscus-widget')!
        const syncTheme = () => {
          widget.theme = document.documentElement.classList.contains('dark')
            ? 'noborder_dark'
            : 'noborder_light'
        }
        this.append(content)
        // Giscus cleans the OAuth URL with replaceState(undefined); retain Astro's entry.
        if (isCallback) history.replaceState(historyState, '')
        syncTheme()
        this.cleanupTheme = observeTheme(syncTheme)
      } catch {
        if (this.isConnected) {
          this.append('评论暂时无法加载，请通过上方 GitHub 链接参与讨论。')
        }
      } finally {
        this.loading = false
      }
    }

    disconnectedCallback() {
      this.observer?.disconnect()
      if (this.idleId !== undefined && 'cancelIdleCallback' in window) {
        cancelIdleCallback(this.idleId)
      }
      if (this.idleTimer !== undefined) clearTimeout(this.idleTimer)
      this.cleanupTheme?.()
    }
  }

  if (!customElements.get('giscus-comments')) {
    customElements.define('giscus-comments', GiscusComments)
  }
</script>

<style>
  .comments {
    width: 100%;
    max-width: var(--blog-prose-width);
    margin: 3rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--c-text) 12%, transparent);
  }
  .comments h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 400;
  }
  .comments p,
  .comments a {
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .comments p {
    margin: 0.75rem 0 0;
    opacity: 0.65;
  }
  .comments a {
    color: var(--accent);
  }
  giscus-comments {
    display: block;
    min-height: 150px;
    margin-top: 1.5rem;
  }
</style>
