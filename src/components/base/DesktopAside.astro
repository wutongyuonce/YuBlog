---
import TocSidebar from '~/components/toc/TocSidebar.astro'
import { FEATURES } from '~/config'

import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props

const { toc } = FEATURES
const tocPosition = Array.isArray(toc) && toc[0] && toc[1].displayPosition
---

{headings.length > 0 && (
  <aside id="desktop-aside" class="desktop-aside" data-position={tocPosition}>
    <TocSidebar {headings} />
  </aside>
)}

<style>
  .desktop-aside {
    /* Keep the TOC inside the side gutter without widening the reading column. */
    --toc-gap: 3rem;
    --toc-edge: calc(50% + var(--blog-prose-width) / 2 + var(--toc-gap));
    --desktop-toc-width: calc(
      50% - var(--blog-prose-width) / 2 - var(--toc-gap) - var(--site-gutter)
    );
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    right: auto;
    left: var(--toc-edge);
    z-index: 100;
    width: min(13rem, var(--desktop-toc-width));
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .desktop-aside[data-position='left'] {
    right: var(--toc-edge);
    left: auto;
  }

  @media (max-width: 1199.9px) {
    .desktop-aside {
      display: none;
    }
  }
</style>
