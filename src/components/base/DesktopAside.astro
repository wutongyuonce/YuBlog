---
import TocSidebar from '~/components/toc/TocSidebar.astro'
import { FEATURES } from '~/config'

import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props

const { toc } = FEATURES
const tocPosition = Array.isArray(toc) && toc[0] && toc[1].displayPosition
const tocDisplayMode = Array.isArray(toc) && toc[0] && toc[1].displayMode
---

{headings.length > 0 && (
  <aside id="desktop-aside" class="desktop-aside" data-position={tocPosition}>
    <button
      type="button"
      class="desktop-aside__trigger"
      aria-label="固定目录"
      aria-pressed="false"
      title="点击固定目录"
      data-display-mode={tocDisplayMode}
    >
      TOC
    </button>
    <TocSidebar {headings} />
  </aside>
)}

<script>
  const setupTocPin = () => {
    const aside = document.getElementById('desktop-aside')
    const trigger = aside?.querySelector<HTMLButtonElement>(
      '.desktop-aside__trigger'
    )
    if (!aside || !trigger || trigger.dataset.pinBound) return
    trigger.dataset.pinBound = 'true'
    trigger.addEventListener('click', () => {
      const on = aside.dataset.pinned !== 'true'
      aside.dataset.pinned = on ? 'true' : 'false'
      trigger.setAttribute('aria-pressed', String(on))
    })
  }

  document.addEventListener('astro:page-load', setupTocPin)
  setupTocPin()
</script>

<style>
  .desktop-aside {
    /* Match .prose.post-content max-width so the gutter math stays aligned. */
    --article-width: 65ch;
    --toc-inset-start: calc(clamp(3.25rem, 6.5vw, 8.5rem) - 1.4rem);
    --toc-inset-end: calc(1.2rem + 1.4rem);
    --desktop-toc-width: calc(
      50% - var(--article-width) / 2 - var(--toc-inset-start) -
        var(--toc-inset-end)
    );
    position: fixed;
    top: 5.75rem;
    right: var(--toc-inset-end);
    left: auto;
    z-index: 100;
    width: var(--desktop-toc-width);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 1280px) {
    .desktop-aside {
      --article-width: 70ch;
    }
  }

  .desktop-aside[data-position='left'] {
    right: auto;
    left: var(--toc-inset-end);
  }

  .desktop-aside__trigger {
    display: inline-flex;
    align-items: center;
    align-self: start;
    margin-inline: -0.4rem;
    padding: 0.15rem 0.4rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--c-text);
    font-size: var(--blog-reading-size);
    font-weight: 500;
    opacity: 0.55;
    cursor: pointer;
    transition:
      opacity 0.25s ease,
      background-color 0.25s ease,
      font-weight 0.25s ease,
      transform 0.25s ease;
  }

  .desktop-aside__trigger[data-display-mode='always'] {
    opacity: 0.82;
  }

  .desktop-aside:hover .desktop-aside__trigger[data-display-mode='hover'],
  :global(.slide-enter-content:hover)
    .desktop-aside__trigger[data-display-mode='content'],
  :global(.group\/content:hover)
    .desktop-aside__trigger[data-display-mode='content'] {
    opacity: 0.82;
  }

  .desktop-aside[data-pinned='true'] .desktop-aside__trigger {
    font-weight: 600;
    opacity: 1;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .desktop-aside[data-pinned='true'] :global(.desktop-toc) {
    opacity: 0.82;
  }

  @media (max-width: 1199.9px) {
    .desktop-aside {
      display: none;
    }
  }
</style>
