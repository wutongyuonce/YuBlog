---
import { formatDate } from '~/utils/datetime'
import { withBasePath } from '~/utils/path'
import { UI } from '~/config'

interface Props {
  pubDate: string
  lastModDate: string | undefined
  minutesRead: number
  tags: string[]
  hasSubtitle: boolean
  variant?: 'default' | 'hero'
}

const {
  pubDate,
  lastModDate,
  minutesRead,
  tags,
  hasSubtitle,
  variant = 'default',
} = Astro.props

const isMinimal = UI.postView.postMetaStyle === 'minimal'
const showLastModDate =
  !!lastModDate && formatDate(lastModDate) !== formatDate(pubDate)
---

{variant === 'hero' ? (
  <div class="post-meta post-meta--hero">
    <img
      class="post-meta__avatar"
      src={withBasePath('/avatar.webp')}
      alt=""
      aria-hidden="true"
    />
    <time datetime={pubDate}>{formatDate(pubDate)}</time>
    {showLastModDate && (
      <time datetime={lastModDate}>· Updated {formatDate(lastModDate)}</time>
    )}
    {minutesRead > 0 && <span>· {minutesRead} min read</span>}
    {tags.length > 0 && <span>· {tags.join(' / ')}</span>}
  </div>
) : isMinimal ? (
  <div
    class:list={[
      'post-meta op-50 lt-md:text-sm',
      hasSubtitle && 'post-meta--with-subtitle',
    ]}
  >
    <time datetime={pubDate}>{formatDate(pubDate)}</time>
    {showLastModDate && (
      <time datetime={lastModDate}> · Updated {formatDate(lastModDate)}</time>
    )}
    {minutesRead > 0 && <span> · {minutesRead} min</span>}
    {tags.length > 0 && <span> · {tags.join(' / ')}</span>}
  </div>
) : (
  <div
    class:list={[
      'post-meta flex justify-start items-center gap-x-4 gap-y-1 flex-wrap lt-md:text-sm op-50',
      hasSubtitle && 'post-meta--with-subtitle',
    ]}
  >
    <div>
      <span class="i-ri-calendar-line mr-1.2" />
      <time datetime={pubDate}>{formatDate(pubDate)}</time>
    </div>
    {showLastModDate && (
      <div>
        <span class="i-ri-history-fill mr-1.2" />
        <time datetime={lastModDate}>{formatDate(lastModDate)}</time>
      </div>
    )}
    <div>
      <span class="i-ri-timer-line mr-1.2 ml--0.6" />
      {minutesRead > 0 && <span>{minutesRead} min read</span>}
    </div>
    {tags.length > 0 && (
      <div>
        <span class="i-ri-hashtag mr-1.2" />
        {tags.join(' / ')}
      </div>
    )}
  </div>
)}

<style>
  .post-meta--hero {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
    margin-top: 1.1rem !important;
    color: var(--c-text);
    font-size: 0.9rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
    opacity: 0.72;
  }

  .post-meta--hero > :not(.post-meta__avatar) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .post-meta__avatar {
    width: 2.5rem !important;
    height: 2.5rem !important;
    margin: 0 0.45rem 0 0 !important;
    border: 1px solid currentColor;
    border-radius: 999px !important;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .post-meta--hero {
      margin-top: 0.9rem !important;
      font-size: 0.8rem;
    }
  }
</style>
