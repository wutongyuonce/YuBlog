---
import { formatPostMetaDate } from '~/utils/post-meta-date.js'
import { tagSelectionLinks } from '~/utils/blog-browser.js'
import TagLinks from '~/components/base/TagLinks.astro'

interface Props {
  pubDate: string
  lastModDate: string | undefined
  minutesRead: number
  wordCount: number
  tags: string[]
  hasSubtitle: boolean
}

const { pubDate, lastModDate, minutesRead, wordCount, tags, hasSubtitle } =
  Astro.props

const visibleTags = tagSelectionLinks(tags)
// 更新于始终显示：作者没写 lastModDate 时与发布日一致。
const lastModIso = lastModDate || pubDate
const pubDateLabel = formatPostMetaDate(pubDate)
const lastModDateLabel = formatPostMetaDate(lastModIso)
const showWordCount = wordCount > 0
const showMinutesRead = minutesRead > 0
const showStatsRow = showWordCount || showMinutesRead || visibleTags.length > 0
---

<div class:list={['post-meta', hasSubtitle && 'post-meta--with-subtitle']}>
  <div class="post-meta__row post-meta__row--dates">
    <span class="post-meta__stat">
      <span class="i-ri-calendar-line post-meta__icon" aria-hidden="true" />
      <span>
        发布于 <time datetime={pubDate}>{pubDateLabel}</time>
      </span>
    </span>
    <span class="post-meta__stat">
      <span class="i-ri-history-fill post-meta__icon" aria-hidden="true" />
      <span>
        更新于 <time datetime={lastModIso}>{lastModDateLabel}</time>
      </span>
    </span>
  </div>
  {showStatsRow && (
    <div class="post-meta__row post-meta__row--stats">
      {showWordCount && (
        <span class="post-meta__stat">
          <span
            class="i-ri-pen-nib-line post-meta__icon post-meta__icon--stat"
            aria-hidden="true"
          />
          <span>{wordCount} 字</span>
        </span>
      )}
      {showMinutesRead && (
        <span class="post-meta__stat">
          <span
            class="i-ri-timer-line post-meta__icon post-meta__icon--stat"
            aria-hidden="true"
          />
          <span>{minutesRead} 分钟</span>
        </span>
      )}
      {visibleTags.length > 0 && (
        <span class="post-meta__tags">
          <span
            class="i-ri-price-tag-3-line post-meta__icon post-meta__icon--stat"
            aria-hidden="true"
          />
          <TagLinks {tags} />
        </span>
      )}
    </div>
  )}
</div>

<style>
  .post-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    color: color-mix(in srgb, var(--c-text) 58%, transparent);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.55;
    text-align: center;
  }

  .post-meta__row {
    display: flex;
    align-items: center;
    gap: 0.4em;
    min-width: 0;
    width: 100%;
  }

  .post-meta__row--dates {
    justify-content: center;
    gap: 1.5rem;
  }

  /* Row gap 0.5rem; each .post-meta__stat adds 0.5rem end margin →
     stat↔stat / stat↔tag-group = 1rem. Inside the tag group the icon sits
     0.35em from the first tag (same as other stats) and tags are 0.5rem apart. */
  .post-meta__row--stats {
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.5rem;
    row-gap: 0.25rem;
  }

  .post-meta__stat {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-width: 0;
    margin-inline-end: 0.5rem;
  }

  /* 日期项不保留尾部 margin，保证整组居中且只由 gap 控制间距。 */
  .post-meta__row--dates .post-meta__stat {
    margin-inline-end: 0;
  }

  /* flex align-items:center 几何居中；粗体宋体光学中线略低、Remix 图标视觉重心偏上，
     vertical-align 在 flex 里无效 → 略下移贴齐文字水平线。列表 ListItem 字更小／非粗体，几何居中已齐，不加 translateY。 */
  .post-meta__icon {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    transform: translateY(0.07em);
  }

  .post-meta__icon--stat {
    width: 1em;
    height: 1em;
  }

  .post-meta__tags {
    /* 标签组整体作为一个 flex 项：一个几何图标 + 组内可换行的标签。 */
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-width: 0;
    margin-inline-end: 0.5rem;
  }

  .post-meta__tags :global(.tag-links) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .post-meta__tags :global(.tag-link) {
    /* Override TagLinks default margin-right: 0.35em; gap comes from the row. */
    margin-right: 0;
    margin-inline-end: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .post-meta {
      font-size: 0.875rem;
    }

    .post-meta__row--dates {
      flex-direction: column;
      justify-content: center;
      gap: 0.3rem;
    }
  }
</style>
