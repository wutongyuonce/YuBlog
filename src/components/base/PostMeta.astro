---
import {
  formatPostMetaDate,
  sameSiteCalendarDate,
} from '~/utils/post-meta-date.js'
import { tagSelectionLinks } from '~/utils/blog-browser.js'
import TagLinks from '~/components/base/TagLinks.astro'

interface Props {
  pubDate: string
  lastModDate: string | undefined
  minutesRead: number
  wordCount: number
  tags: string[]
  hasSubtitle: boolean
}

const { pubDate, lastModDate, minutesRead, wordCount, tags, hasSubtitle } =
  Astro.props

const visibleTags = tagSelectionLinks(tags)
const showLastModDate =
  !!lastModDate && !sameSiteCalendarDate(lastModDate, pubDate)
const pubDateLabel = formatPostMetaDate(pubDate)
const lastModDateLabel =
  showLastModDate && lastModDate ? formatPostMetaDate(lastModDate) : ''
const showWordCount = wordCount > 0
const showMinutesRead = minutesRead > 0
const showSecondRow =
  showLastModDate || showWordCount || showMinutesRead || visibleTags.length > 0
---

<div class:list={['post-meta', hasSubtitle && 'post-meta--with-subtitle']}>
  <div class="post-meta__row">
    <span class="i-ri-calendar-line post-meta__icon" aria-hidden="true" />
    <span>
      发布于 <time datetime={pubDate}>{pubDateLabel}</time>
    </span>
  </div>
  {showSecondRow && (
    <div class="post-meta__row post-meta__row--wrap">
      {showLastModDate && (
        <span class="post-meta__stat">
          <span class="i-ri-history-fill post-meta__icon" aria-hidden="true" />
          <span>
            更新于 <time datetime={lastModDate}>{lastModDateLabel}</time>
          </span>
        </span>
      )}
      {showWordCount && (
        <span class="post-meta__stat">
          <span
            class="i-ri-pen-nib-line post-meta__icon post-meta__icon--stat"
            aria-hidden="true"
          />
          <span>{wordCount} 字</span>
        </span>
      )}
      {showMinutesRead && (
        <span class="post-meta__stat">
          <span
            class="i-ri-timer-line post-meta__icon post-meta__icon--stat"
            aria-hidden="true"
          />
          <span>{minutesRead} 分钟</span>
        </span>
      )}
      {visibleTags.length > 0 && (
        <span class="post-meta__tags">
          <TagLinks {tags} />
        </span>
      )}
    </div>
  )}
</div>

<style>
  .post-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    color: color-mix(in srgb, var(--c-text) 58%, transparent);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .post-meta__row {
    display: flex;
    align-items: center;
    gap: 0.4em;
    min-width: 0;
  }

  /* Group gap (字数／时长／标签组／更新于) stays even; tags use a tighter gap. */
  .post-meta__row--wrap {
    flex-wrap: wrap;
    column-gap: 1rem;
    row-gap: 0.25rem;
  }

  .post-meta__stat {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-width: 0;
  }

  .post-meta__icon {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  .post-meta__icon--stat {
    width: 1em;
    height: 1em;
  }

  .post-meta__tags {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0.25rem;
    min-width: 0;
  }

  .post-meta__tags :global(.tag-links) {
    display: contents;
  }

  .post-meta__tags :global(.tag-link) {
    margin-right: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .post-meta {
      font-size: 0.875rem;
    }
  }
</style>
