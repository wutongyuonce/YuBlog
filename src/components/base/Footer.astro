---
import Link from '~/components/base/Link.astro'
import { SITE } from '~/config'

const currentYear = new Date().getFullYear()
const copyrightText = `© ${currentYear} ${SITE.author}`
---

<footer class="slide-enter animate-delay-1600! px-7 mt-auto mb-8">
  <div class="prose mx-auto">
    <div class="flex flex-wrap gap-y-1 lt-sm:flex-col items-center text-sm whitespace-nowrap">
      <span class="op-50">{copyrightText}</span>
      <span class="footer-mark lt-sm:hidden" aria-hidden="true"></span>
      <span class="op-50">
        Built with
        <Link
          class="op-100! color-[--fg]!"
          href="https://astro.build"
          external={true}
        >
          Astro
        </Link>
      </span>
      <span class="footer-mark lt-sm:hidden" aria-hidden="true"></span>
      <Link
        href="https://icp.gov.moe/?keyword=20269668"
        target="_blank"
        rel="noopener noreferrer"
      >
        萌ICP备20269668号
      </Link>
    </div>
  </div>
</footer>

<style>
  .footer-mark {
    flex: none;
    width: 0.38rem;
    height: 0.38rem;
    margin-inline: 0.55rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
  }
</style>
