---
interface Props {
  title: string
  subtitle: string
  id?: string
}

const { title, subtitle, id } = Astro.props
---

<header class="section-heading">
  <h1 {id}>{title}</h1>
  <p>{subtitle}</p>
</header>

<style>
  .section-heading h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.3;
  }
  .section-heading p {
    margin: 0.6rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--c-text) 55%, var(--c-bg));
  }
</style>
