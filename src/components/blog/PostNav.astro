---
import { getFilteredPosts, getSortedPosts } from '~/utils/data'
import { getPostNeighbors, type PostNavItem } from '~/utils/post-nav'
import { withBasePath } from '~/utils/path'

interface Props {
  currentId: string
}

const { currentId } = Astro.props

const posts = getSortedPosts(await getFilteredPosts('blogs'))
const items: PostNavItem[] = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  href: post.data.redirect || withBasePath(`/blogs/${post.id}/`),
}))
const { prev, next } = getPostNeighbors(items, currentId)
const showNav = Boolean(prev || next)
---

{showNav && (
  <nav class="post-nav" aria-label="文章导航">
    <div class="post-nav__row">
      {prev ? (
        <a class="post-nav__link post-nav__link--prev" href={prev.href}>
          <span class="post-nav__label">← 上一篇</span>
          <span class="post-nav__title">{prev.title}</span>
        </a>
      ) : (
        <span class="post-nav__spacer" aria-hidden="true" />
      )}
      {next ? (
        <a class="post-nav__link post-nav__link--next" href={next.href}>
          <span class="post-nav__label">下一篇 →</span>
          <span class="post-nav__title">{next.title}</span>
        </a>
      ) : (
        <span class="post-nav__spacer" aria-hidden="true" />
      )}
    </div>
  </nav>
)}

<style>
  .post-nav {
    width: 100%;
    max-width: var(--blog-prose-width);
    margin-inline: auto;
    margin-top: 1rem;
    margin-bottom: 0.25rem;
  }

  .post-nav__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  /* 容器控件：底色 + 标题变色；见 docs/design/site.md#visuals */
  .post-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.7rem 0.8rem;
    border-radius: 0.7rem;
    color: inherit;
    text-decoration: none;
    border-bottom: none;
    transition: background-color 0.2s ease;
  }

  .post-nav__link--prev {
    align-items: flex-start;
    text-align: left;
  }

  .post-nav__link--next {
    align-items: flex-end;
    text-align: right;
  }

  .post-nav__label {
    color: color-mix(in srgb, var(--c-text) 48%, transparent);
    font-size: 0.75rem;
    line-height: 1.35;
    font-weight: 400;
  }

  .post-nav__title {
    color: var(--c-text);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  .post-nav__link:hover,
  .post-nav__link:focus-visible {
    background: color-mix(in srgb, var(--c-text) 6%, var(--c-bg));
  }

  .post-nav__link:hover .post-nav__title,
  .post-nav__link:focus-visible .post-nav__title {
    color: var(--accent);
  }

  .post-nav__spacer {
    min-height: 1px;
  }

  @media (max-width: 480px) {
    .post-nav__row {
      gap: 0.4rem;
    }

    .post-nav__link {
      padding: 0.6rem 0.55rem;
    }

    .post-nav__title {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-nav__link,
    .post-nav__title {
      transition: none;
    }
  }
</style>
