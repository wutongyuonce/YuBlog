---
import RandomBrowse from './RandomBrowse.astro'
import { getFilteredPosts, getSortedPosts } from '~/utils/data'
import { getPostNeighbors, type PostNavItem } from '~/utils/post-nav'
import { withBasePath } from '~/utils/path'

interface Props {
  currentId: string
}

const { currentId } = Astro.props

const posts = getSortedPosts(await getFilteredPosts('blogs'))
const items: PostNavItem[] = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  href: post.data.redirect || withBasePath(`/blogs/${post.id}/`),
}))
const { prev, next } = getPostNeighbors(items, currentId)
const showNav = Boolean(prev || next || items.length > 1)
---

{showNav && (
  <nav class="post-nav prose mx-auto" aria-label="文章导航">
    <div class="post-nav__row">
      {prev ? (
        <a class="post-nav__link" href={prev.href} title={prev.title}>
          <span class="post-nav__icon" aria-hidden="true">
            ←
          </span>
          上一篇
        </a>
      ) : (
        <span class="post-nav__spacer" aria-hidden="true" />
      )}
      <RandomBrowse candidates={items} excludeId={currentId} landmark={false} />
      {next ? (
        <a class="post-nav__link" href={next.href} title={next.title}>
          下一篇
          <span class="post-nav__icon" aria-hidden="true">
            →
          </span>
        </a>
      ) : (
        <span class="post-nav__spacer" aria-hidden="true" />
      )}
    </div>
  </nav>
)}

<style>
  .post-nav {
    margin-top: 1.75rem;
    margin-bottom: 0.25rem;
  }

  .post-nav__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
  }

  .post-nav__row > :first-child {
    justify-self: start;
  }

  .post-nav__row > :last-child {
    justify-self: end;
  }

  /* Match markdown body links: soft underline, accent on hover. */
  .post-nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    width: fit-content;
    max-width: 100%;
    color: var(--fg-deeper, var(--c-text));
    font-size: 0.9375rem;
    line-height: 1.5;
    font-weight: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(125, 125, 125, 0.3);
    transition: border-color 0.3s ease-in-out;
  }

  .post-nav__link:hover,
  .post-nav__link:focus-visible {
    border-bottom-color: var(--accent);
  }

  .post-nav__icon {
    color: color-mix(in srgb, var(--c-text) 48%, transparent);
  }

  .post-nav__spacer {
    min-height: 1px;
  }

  @media (max-width: 480px) {
    .post-nav__row {
      gap: 0.45rem;
    }

    .post-nav__link,
    .post-nav :global(.random-browse__link) {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-nav__link {
      transition: none;
    }
  }
</style>
