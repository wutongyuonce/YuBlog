---
import ProgressStats from '~/components/widgets/ProgressStats.astro'
import { withBasePath } from '~/utils/path'
import { AUTHOR_LINKS } from '~/config'
---

<section class="blog-profile" aria-labelledby="blog-profile-name">
  <ProgressStats />
  <div class="blog-profile__top">
    <a class="blog-profile__identity" href={withBasePath('/about/')}>
      <div class="blog-profile__heading">
        <h2 id="blog-profile-name">梧桐雨</h2>
        <span class="blog-profile__mbti">INTJ</span>
      </div>
      <span class="blog-profile__avatar" aria-hidden="true">
        <img src={withBasePath('/avatar.webp')} width="56" height="56" alt="" />
      </span>
    </a>
    <a class="blog-profile__rss" href={withBasePath('/rss.xml')}>
      <span>订阅 RSS</span>
      <span
        class="blog-profile__arrow i-ri-arrow-right-up-line"
        aria-hidden="true"
      ></span>
    </a>
  </div>
  <div class="blog-profile__details">
    <p class="blog-profile__motto">「我与我周旋久，宁做我」</p>
    <nav class="blog-profile__social" aria-label="联系与社交媒体">
      {AUTHOR_LINKS.map(({ label, href, icon }) => (
        <a
          {href}
          title={label}
          rel={href.startsWith('mailto:') ? undefined : 'me'}
        >
          <span
            class:list={['blog-profile__social-icon', icon]}
            aria-hidden="true"
          />
          <span class="sr-only">{label}</span>
        </a>
      ))}
    </nav>
  </div>
</section>
