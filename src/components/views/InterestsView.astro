---
import { getCollection, render } from 'astro:content'
import { withBasePath } from '~/utils/path'
import PageHeading from '~/components/base/PageHeading.astro'
import GiscusComments from '~/components/base/GiscusComments.astro'
import Toc from '~/components/toc/Toc.astro'
import PlaylistsPanel from '~/components/interests/PlaylistsPanel.astro'
import MediaHub from '~/components/interests/MediaHub.astro'
import MarkdownTabs from '~/components/interests/MarkdownTabs.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry?: CollectionEntry<'interests'>
}
const { entry } = Astro.props
const entries = entry
  ? []
  : (await getCollection('interests')).sort(
      (a, b) => a.data.order - b.data.order
    )
const { Content, headings } = entry
  ? await render(entry)
  : { Content: null, headings: [] }
// 合页（组件或页签渲染）的顶层 Markdown 正文作为页头引言，空正文不输出。
const hasIntro = Boolean(entry?.body?.trim())
// 同名子目录里有 Markdown 时，该分类渲染为页签合页。
const tabEntries = entry
  ? (await getCollection('interestTabs'))
      .filter((tab) => tab.id.startsWith(`${entry.id}/`))
      .sort((a, b) => a.data.order - b.data.order)
  : []
---

<div class="interests-page">
  <PageHeading
    title={entry ? entry.data.title : '拾趣'}
    subtitle={
      entry ? entry.data.description : '日常在用的东西，与闲暇时喜欢的故事。'
    }
  />
  {entry?.id === 'playlists' ? (
    <div data-interest={entry.id}>
      <PlaylistsPanel />
    </div>
  ) : entry?.id === 'media' || (entry && tabEntries.length > 0) ? (
    <div data-interest={entry.id}>
      {hasIntro && Content && (
        <div class="prose markdown-content interests-page__intro">
          <Content />
        </div>
      )}
      {entry.id === 'media' ? (
        <MediaHub />
      ) : (
        <MarkdownTabs label={entry.data.title} entries={tabEntries} />
      )}
    </div>
  ) : entry && Content ? (
    <article
      class="prose markdown-content interests-page__content"
      data-interest={entry.id}
    >
      <Toc {headings} />
      <Content />
    </article>
  ) : (
    <>
      <nav aria-label="拾趣分类" class="interests-page__index">
        {entries.map(({ id, data }) => (
          <a href={withBasePath(`/interests/${id}/`)}>
            <span>{data.title}</span>
            <small>{data.description}</small>
          </a>
        ))}
      </nav>
    </>
  )}
  {entry && <GiscusComments />}
</div>

<style>
  /* 引言就是 Markdown 正文，字体、字号与链接全部沿用 prose，只管与页头的间距。 */
  .interests-page__intro {
    margin-top: 1.5rem;
  }
  .interests-page__content {
    margin-top: 2rem;
  }
  .interests-page__index {
    margin-top: 2rem;
  }
  .interests-page__index a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--c-text) 10%, transparent);
    color: inherit;
    text-decoration: none;
  }
  .interests-page__index a:hover,
  .interests-page__index a:focus-visible {
    color: var(--accent);
  }
  /* 整行是链接，但下划线只画在标题上，与归档时间线一致。 */
  .interests-page__index a:is(:hover, :focus-visible) span {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.16em;
  }
  .interests-page__index span {
    min-width: 4.5rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.4;
  }
  .interests-page__index small {
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--c-text) 55%, var(--c-bg));
  }
</style>
