---
import ListItem from './ListItem.astro'
import { getBlogListItems } from '~/utils/data'
import { withBasePath } from '~/utils/path'

interface Props {
  basePath?: string
  requireTags?: boolean
}

const { basePath = withBasePath('/'), requireTags = false } = Astro.props
const posts = await getBlogListItems()
---

<section
  data-blog-browser
  data-home={basePath}
  data-require-tags={requireTags ? '' : undefined}
  aria-label="文章列表"
>
  {!requireTags && (
    <>
      <header class="blog-category-header" data-category-header hidden>
        <p class="blog-category-kicker">分类</p>
        <h1 data-category-title>文章</h1>
        <p class="blog-category-count" data-category-count></p>
      </header>
      <h1 class="sr-only" data-default-title>
        文章
      </h1>
    </>
  )}
  {requireTags ? (
    <noscript>启用 JavaScript 后可按标签筛选文章。</noscript>
  ) : (
    <noscript>当前显示全部文章；启用 JavaScript 后可筛选和分页。</noscript>
  )}
  <div class="blog-filters" data-filters hidden></div>
  <p class="sr-only" data-status aria-live="polite"></p>
  <div data-list-panel hidden={requireTags}>
    <div data-post-list>
      {posts.map((item) => (
        <div
          data-blog-item
          data-category={item.data.category}
          data-tags={JSON.stringify(item.data.tags)}
        >
          <ListItem {item} />
        </div>
      ))}
    </div>
    <p data-empty hidden>
      没有符合条件的文章。<a href={basePath}>清空筛选</a>
    </p>
    <nav data-pagination aria-label="文章分页" hidden></nav>
  </div>
</section>
<style is:global>
  [data-blog-item]:not([hidden]) ~ [data-blog-item]:not([hidden]) {
    padding-top: 24px;
  }
  [data-blog-browser][data-require-tags] [data-list-panel]:not([hidden]) {
    margin-top: 2.5rem;
  }
  [data-blog-browser] [hidden] {
    display: none !important;
  }
  .blog-category-header {
    margin-bottom: 2rem;
  }
  .blog-category-kicker {
    margin: 0 0 0.45rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--c-text) 55%, transparent);
  }
  .blog-category-header h1 {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 650;
    line-height: 1.25;
  }
  .blog-category-count {
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--c-text) 50%, transparent);
  }
  .blog-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .blog-filters a,
  [data-pagination] a,
  [data-pagination] span[aria-disabled] {
    padding: 0.5rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--c-text) 12%, transparent);
    border-radius: 7px;
    color: inherit;
    text-decoration: none;
  }
  [data-pagination] {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 2.25rem;
  }
  [data-pagination] > :last-child {
    justify-self: end;
  }
  [data-pagination] > :first-child {
    justify-self: start;
  }
  [data-pagination] div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  [data-pagination] a {
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }
  [data-pagination] a:hover {
    background: color-mix(in srgb, var(--c-text) 8%, transparent);
    border-color: color-mix(in srgb, var(--c-text) 28%, transparent);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--c-text) 10%, transparent);
    transform: translateY(-1px);
  }
  [data-pagination] [aria-current] {
    background: var(--c-text);
    color: var(--c-bg);
    border-color: transparent;
  }
  [data-pagination] [aria-current]:hover {
    background: var(--c-text);
    color: var(--c-bg);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--c-text) 22%, transparent);
  }
  [data-pagination] [aria-disabled] {
    opacity: 0.4;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-pagination] a {
      transition: none;
    }
    [data-pagination] a:hover {
      transform: none;
    }
  }
  @media (max-width: 767px) {
    .blog-category-header h1 {
      font-size: 1.85rem;
    }
    [data-pagination] {
      grid-template-columns: 1fr 1fr;
    }
    [data-pagination] div {
      grid-area: 1 / 1 / 2 / 3;
      justify-content: center;
    }
  }
</style>
<script>
  import {
    parseBlogQuery,
    serializeBlogQuery,
    selectBlogPage,
    getPageNumbers,
  } from '~/utils/blog-browser.js'
  const update = () => {
    const root = document.querySelector<HTMLElement>('[data-blog-browser]')
    if (!root) return
    const home = root.dataset.home!
    const requireTags = root.hasAttribute('data-require-tags')
    const query = parseBlogQuery(location.search)
    const posts = Array.from(
      root.querySelectorAll<HTMLElement>('[data-blog-item]')
    ).map((element) => ({
      element,
      data: {
        category: element.dataset.category!,
        tags: JSON.parse(element.dataset.tags!) as string[],
      },
    }))
    const header = root.querySelector<HTMLElement>('[data-category-header]')
    const defaultTitle = root.querySelector<HTMLElement>('[data-default-title]')
    const filters = root.querySelector<HTMLElement>('[data-filters]')!
    const empty = root.querySelector<HTMLElement>('[data-empty]')!
    const pagination = root.querySelector<HTMLElement>('[data-pagination]')!
    const panel = root.querySelector<HTMLElement>('[data-list-panel]')!
    const showList = !requireTags || query.tags.length > 0
    if (!showList) {
      posts.forEach((post) => (post.element.hidden = true))
      if (header) header.hidden = true
      if (defaultTitle) defaultTitle.hidden = false
      filters.hidden = true
      empty.hidden = true
      pagination.hidden = true
      panel.hidden = true
      root.querySelector('[data-status]')!.textContent = ''
      return
    }
    const result = selectBlogPage(posts, query)
    query.page = result.page
    const canonical = new URL(location.href)
    if (query.page === 1) canonical.searchParams.delete('page')
    else canonical.searchParams.set('page', String(query.page))
    if (canonical.href !== location.href)
      history.replaceState(history.state, '', canonical)

    const visible = new Set(result.items)
    posts.forEach((post) => (post.element.hidden = !visible.has(post)))
    panel.hidden = false
    empty.hidden = result.total !== 0
    root.querySelector('[data-status]')!.textContent =
      `共 ${result.total} 篇文章，第 ${result.page} 页`
    const showCategoryHeader = Boolean(query.category) && Boolean(header)
    if (header) header.hidden = !showCategoryHeader
    if (defaultTitle) defaultTitle.hidden = showCategoryHeader
    if (showCategoryHeader && header) {
      root.querySelector('[data-category-title]')!.textContent = query.category
      root.querySelector('[data-category-count]')!.textContent =
        `共 ${result.total} 篇文章`
    }
    const link = (label: string, state: typeof query) => {
      const a = document.createElement('a')
      a.textContent = label
      a.href = home + serializeBlogQuery(state)
      return a
    }
    filters.replaceChildren()
    const showFilters = !requireTags && query.tags.length > 0
    filters.hidden = !showFilters
    if (showFilters) {
      query.tags.forEach((tag) =>
        filters.append(
          link(`${tag} ×`, {
            ...query,
            tags: query.tags.filter((t) => t !== tag),
            page: 1,
          })
        )
      )
      filters.append(link('清空筛选', { category: '', tags: [], page: 1 }))
      if (!query.category) {
        const count = document.createElement('span')
        count.textContent = `共 ${result.total} 篇`
        const tagsLink = document.createElement('a')
        tagsLink.textContent = '全部标签'
        tagsLink.href = `${home}tags/`
        filters.append(count, tagsLink)
      }
    }
    pagination.replaceChildren()
    pagination.hidden = result.pageCount <= 1
    const control = (label: string, page: number, disabled: boolean) => {
      if (!disabled) return link(label, { ...query, page })
      const span = document.createElement('span')
      span.textContent = label
      span.setAttribute('aria-disabled', 'true')
      return span
    }
    const numbers = document.createElement('div')
    getPageNumbers(query.page, result.pageCount).forEach((number) => {
      if (number === '…') {
        const span = document.createElement('span')
        span.textContent = number
        numbers.append(span)
        return
      }
      const a = link(String(number), { ...query, page: number })
      if (number === query.page) a.setAttribute('aria-current', 'page')
      numbers.append(a)
    })
    pagination.append(
      control('← 上一页', query.page - 1, query.page === 1),
      numbers,
      control('下一页 →', query.page + 1, query.page === result.pageCount)
    )
    if (!requireTags)
      document
        .querySelectorAll<HTMLAnchorElement>('[data-blog-category]')
        .forEach((a) => {
          a.href =
            home +
            serializeBlogQuery({
              ...query,
              category: a.dataset.blogCategory!,
              page: 1,
            })
          if (a.dataset.blogCategory === query.category)
            a.setAttribute('aria-current', 'true')
          else a.removeAttribute('aria-current')
        })
  }
  document.addEventListener('astro:page-load', update)
  document.addEventListener('blog:querychange', update)
  window.addEventListener('popstate', update)
  update()
</script>
