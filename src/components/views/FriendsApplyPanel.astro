---
import Link from '~/components/base/Link.astro'

const dataFilePath = 'src/content/friends/data.json'
const prUrl =
  'https://github.com/wutongyuonce/YuBlog/edit/main/src/content/friends/data.json'

const friendInfo = {
  name: 'CN：梧桐雨/EN：WutongRain，选一个',
  desc: 'Coding, Living and Loving.',
  link: 'https://www.wutongyu.site/',
  avatar: 'https://www.wutongyu.site/avatar.webp',
}

const referenceTemplate = `Name: ${friendInfo.name}
Desc: ${friendInfo.desc}
Link: ${friendInfo.link}
Avatar: ${friendInfo.avatar}`
---

<aside class="friends-apply" aria-label="申请友链">
  <section class="friends-apply__intro">
    <h3>交换友链</h3>
    <ol class="friends-apply__rules">
      <li>
        <span class="friends-apply__index">01</span>
        <span class="friends-apply__rule-text">先友后链</span>
      </li>
      <li>
        <span class="friends-apply__index">02</span>
        <span class="friends-apply__rule-text">站点使用 https 协议</span>
      </li>
    </ol>
    <p class="friends-apply__hint">
      在仓库的 <code>{dataFilePath}</code>{' '}
      数组末尾追加一条对象，补上上一项的逗号，然后提交 Pull Request。
    </p>
    <Link href={prUrl} external={true} class="friends-apply__pr">
      在 GitHub 提交 PR
    </Link>
  </section>

  <section class="friends-apply__block" aria-label="参考格式">
    <h3 class="sr-only">参考格式</h3>
    <div class="friends-apply__editor">
      <header class="friends-apply__titlebar">
        <span class="friends-apply__dots" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span class="friends-apply__filename">friend.txt</span>
        <button
          class="friends-apply__copy"
          type="button"
          data-copy-target="friend-format"
        >
          复制
        </button>
      </header>
      <pre id="friend-format">{referenceTemplate}</pre>
    </div>
  </section>
</aside>

<script>
  const setupCopyButtons = () => {
    document
      .querySelectorAll<HTMLButtonElement>('[data-copy-target]')
      .forEach((button) => {
        if (button.dataset.copyBound) return
        button.dataset.copyBound = 'true'
        let resetTimer: number | undefined
        let copyAttempt = 0
        button.addEventListener('click', async () => {
          const currentAttempt = ++copyAttempt
          if (resetTimer !== undefined) {
            window.clearTimeout(resetTimer)
            resetTimer = undefined
          }

          const target = document.getElementById(
            button.dataset.copyTarget ?? ''
          )
          if (!target) return

          try {
            await navigator.clipboard.writeText(target.textContent ?? '')
            button.textContent = '已复制'
          } catch {
            button.textContent = '复制失败'
          }

          if (currentAttempt !== copyAttempt) return
          resetTimer = window.setTimeout(() => {
            button.textContent = '复制'
            resetTimer = undefined
          }, 1600)
        })
      })
  }

  document.addEventListener('astro:page-load', setupCopyButtons)
  setupCopyButtons()
</script>

<style>
  .friends-apply {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 1.05fr);
    gap: 1.5rem 1.75rem;
    align-items: start;
  }

  .friends-apply__intro {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.35rem 0.15rem 0;
  }

  .friends-apply__intro h3 {
    margin: 0;
    color: var(--c-text);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .friends-apply__rules {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.5rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .friends-apply__rules li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    color: var(--c-text);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .friends-apply__index {
    color: var(--friends-subtle);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .friends-apply__rule-text {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .friends-apply__hint {
    margin: 0.1rem 0 0;
    color: var(--friends-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .friends-apply__hint code {
    color: var(--c-text);
    font-size: 0.84em;
    overflow-wrap: anywhere;
  }

  .friends-apply__pr {
    margin-top: 0.2rem;
    justify-self: start;
    padding: 0.38rem 0.78rem;
    border: 1px solid var(--friends-border);
    border-radius: 0.55rem;
    background: var(--c-bg);
    color: var(--friends-muted);
    font-size: 0.86rem;
    line-height: 1.4;
    opacity: 1;
    transition:
      border-color 180ms ease,
      color 180ms ease;
  }

  .friends-apply__pr:hover {
    border-color: var(--friends-border-strong);
    color: var(--c-text);
  }

  .friends-apply__block {
    min-width: 0;
  }

  .friends-apply__editor {
    overflow: hidden;
    border: 1px solid var(--friends-border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--c-bg) 92%, var(--c-text) 8%);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--c-text) 8%, transparent);
  }

  .friends-apply__titlebar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.15rem;
    padding: 0 0.55rem 0 0.75rem;
    border-bottom: 1px solid var(--friends-border);
    background: color-mix(in srgb, var(--c-bg) 82%, var(--c-text) 18%);
  }

  .friends-apply__dots {
    display: flex;
    gap: 0.32rem;
  }

  .friends-apply__dots i {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: #ff5f57;
  }

  .friends-apply__dots i:nth-child(2) {
    background: #febc2e;
  }

  .friends-apply__dots i:nth-child(3) {
    background: #28c840;
  }

  .friends-apply__filename {
    overflow: hidden;
    color: var(--friends-muted);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'DM Mono',
      monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friends-apply pre {
    margin: 0;
    min-height: 9.5rem;
    padding: 1rem 1rem 1.15rem;
    color: var(--c-text);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'DM Mono',
      monospace;
    font-size: 0.82rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .friends-apply__copy {
    padding: 0.18rem 0.55rem;
    border: 1px solid var(--friends-border);
    border-radius: 6px;
    background: color-mix(in srgb, var(--c-bg) 88%, var(--c-text) 12%);
    color: var(--friends-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.72rem;
  }

  .friends-apply__copy:hover {
    color: var(--c-text);
  }

  @media (max-width: 920px) {
    .friends-apply {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .friends-apply__intro {
      padding: 0;
    }
  }
</style>
