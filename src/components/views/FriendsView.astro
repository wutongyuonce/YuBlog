---
import Link from '~/components/base/Link.astro'
import FriendsApplyPanel from '~/components/views/FriendsApplyPanel.astro'
import { getSortedFriends } from '~/utils/data'

function getInitial(name: string) {
  return name.trim().charAt(0).toUpperCase() || '?'
}

const friends = await getSortedFriends('friends')
const isEmpty = friends.length === 0
const groups = [
  { title: '推荐', description: '单向收藏，常读的博客与站点。' },
  { title: '双向', description: '交换友链的朋友们。' },
].map((group) => ({
  ...group,
  items: friends.filter((item) => item.data.category === group.title),
}))
---

<section class="friends-page">
  {isEmpty ? (
    <section class="friends-shell slide-enter">
      <div class="friends-empty">
        <span class="friends-chip">Friends</span>
        <h2>友链系统已经接入完成</h2>
        <p>
          当前还没有友链数据，直接编辑{' '}
          <code>src/content/friends/data.json</code> 即可开始添加站点卡片。
        </p>
      </div>

      <FriendsApplyPanel />
    </section>
  ) : (
    <section class="friends-shell slide-enter">
      <div class="friends-board">
        {groups.map((group) => (
          <section
            class="friends-group"
            aria-labelledby={`friends-${group.title}`}
          >
            <header class="friends-group__heading">
              <h2 id={`friends-${group.title}`}>{group.title}</h2>
              <p>{group.description}</p>
            </header>
            <div class="friends-grid">
              {group.items.map((item) => (
                <Link
                  href={item.data.link}
                  external={true}
                  class="friend-card"
                  title={item.data.desc}
                >
                  <div class="friend-card__avatar-wrap" aria-hidden="true">
                    {item.data.avatar ? (
                      <img
                        class="friend-card__avatar"
                        src={item.data.avatar}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                      />
                    ) : (
                      <span class="friend-card__avatar-fallback">
                        {getInitial(item.data.name)}
                      </span>
                    )}
                  </div>

                  <div class="friend-card__body">
                    <div class="friend-card__topline">
                      <h3>{item.data.name}</h3>
                    </div>

                    {item.data.siteLabel && (
                      <p class="friend-card__label">{item.data.siteLabel}</p>
                    )}

                    <p class="friend-card__desc">{item.data.desc}</p>
                  </div>
                </Link>
              ))}
            </div>
          </section>
        ))}
      </div>

      <FriendsApplyPanel />
    </section>
  )}
</section>

<style>
  .friends-page {
    width: 100%;
    max-width: 100%;
    margin: 0;
    --friends-shell-bg: transparent;
    --friends-panel-bg: transparent;
    --friends-card-bg: color-mix(in srgb, var(--c-bg) 99%, var(--c-text) 1%);
    --friends-border: color-mix(in srgb, var(--c-text) 10%, transparent);
    --friends-border-strong: color-mix(in srgb, var(--c-text) 18%, transparent);
    --friends-muted: color-mix(in srgb, var(--c-text) 60%, transparent);
    --friends-subtle: color-mix(in srgb, var(--c-text) 44%, transparent);
    --friends-avatar-ring: color-mix(in srgb, var(--c-bg) 90%, transparent);
  }

  :global(.dark) .friends-page {
    --friends-shell-bg: transparent;
    --friends-panel-bg: transparent;
    --friends-card-bg: #000;
    --friends-border: color-mix(in srgb, var(--c-text) 14%, transparent);
    --friends-border-strong: color-mix(in srgb, var(--c-text) 24%, transparent);
    --friends-muted: color-mix(in srgb, var(--c-text) 68%, transparent);
    --friends-subtle: color-mix(in srgb, var(--c-text) 48%, transparent);
    --friends-avatar-ring: color-mix(in srgb, var(--c-bg) 84%, transparent);
  }

  .friends-shell {
    display: grid;
    gap: 1.25rem;
  }

  .friends-empty {
    padding: 1.35rem 1.35rem 1.45rem;
    border: 1px solid var(--friends-border);
    border-radius: 1.8rem;
    background: var(--friends-shell-bg);
  }

  .friends-board {
    display: grid;
    gap: 2.25rem;
  }

  .friends-group__heading {
    margin-bottom: 1rem;
  }

  .friends-group__heading h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--c-text);
  }

  .friends-group__heading p {
    margin: 0.4rem 0 0;
    color: var(--friends-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .friends-chip {
    color: var(--accent);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .friends-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .friend-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    min-height: 6.3rem;
    padding: 0.8rem;
    border: 1px solid var(--friends-border);
    border-radius: 0.75rem;
    background: var(--friends-card-bg);
    color: inherit;
    opacity: 1;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .friend-card:hover,
  .friend-card:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--c-bg));
    background: var(--friends-card-bg);
    box-shadow: 0 0 1rem color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .friend-card:hover .friend-card__topline h3,
  .friend-card:focus-visible .friend-card__topline h3 {
    color: var(--accent);
  }

  .friend-card__avatar-wrap {
    position: relative;
    width: 3rem;
    height: 3rem;
    flex: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-bg) 88%, var(--c-text) 12%);
    box-shadow: 0 0 0 0.28rem var(--friends-avatar-ring);
    overflow: hidden;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .friend-card:is(:hover, :focus-visible) .friend-card__avatar-wrap {
    transform: scale(1.1);
    box-shadow: 0 0 1rem color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .friend-card__avatar {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: inherit;
    object-fit: cover;
    object-position: center;
  }

  .friend-card__avatar-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .friend-card__avatar-fallback {
    font-size: 1.35rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--c-text) 78%, transparent);
  }

  .friend-card__body {
    min-width: 0;
  }

  .friend-card__topline {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .friend-card__topline h3 {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: color-mix(in srgb, var(--c-text) 92%, transparent);
    transition: color 180ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-card,
    .friend-card__avatar-wrap,
    .friend-card__topline h3 {
      transition: none;
    }
  }

  .friend-card__label,
  .friend-card__desc,
  .friends-empty p,
  .friends-empty h2 {
    margin: 0;
  }

  .friend-card__label {
    margin-top: 0.35rem;
    color: var(--friends-subtle);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .friend-card__desc {
    display: -webkit-box;
    margin-top: 0.32rem;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    color: var(--friends-muted);
    font-size: 0.8125rem;
    line-height: 1.52;
  }

  .friends-empty {
    display: grid;
    gap: 0.85rem;
    justify-items: start;
    padding: 1.6rem;
  }

  .friends-empty h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.2rem;
    color: color-mix(in srgb, var(--c-text) 92%, transparent);
  }

  .friends-empty p {
    color: var(--friends-muted);
    line-height: 1.7;
  }

  .friends-empty code {
    padding: 0.08rem 0.4rem;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--c-text) 8%, transparent);
    font-size: 0.92em;
  }

  @media (max-width: 600px) {
    .friends-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .friends-page {
      width: 100%;
    }

    .friends-empty {
      padding: 1rem;
      border-radius: 1.25rem;
    }
  }
</style>
