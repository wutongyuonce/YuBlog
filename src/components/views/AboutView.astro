---
import { getCollection, render } from 'astro:content'

const entries = await getCollection('about')
const intro = entries.find((entry) => !entry.data.tab)
const tabs = entries
  .filter((entry) => entry.data.tab)
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id))

const IntroContent = intro ? (await render(intro)).Content : null
/** 与 src/content/about 的文件名对应。同一套 Remix line，尺寸由 shell.css 固定。 */
const tabIcons: Record<string, string> = {
  about: 'i-ri-user-3-line',
  use: 'i-ri-apps-line',
  hobby: 'i-ri-heart-line',
  soul: 'i-ri-ghost-line',
}

const panels = await Promise.all(
  tabs.map(async (entry, index) => ({
    id: entry.id,
    tabId: `about-tab-${index}`,
    panelId: `about-panel-${index}`,
    title: entry.data.title,
    icon: tabIcons[entry.id],
    Content: (await render(entry)).Content,
  }))
)
---

<section class="about-page">
  {panels.length > 0 && (
    <>
      <div class="about-tabs" role="tablist" aria-label="关于">
        <span class="about-tabs__indicator" aria-hidden="true" />
        {panels.map((panel, index) => (
          <button
            type="button"
            role="tab"
            id={panel.tabId}
            data-about-tab={panel.id}
            aria-controls={panel.panelId}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            {panel.icon && (
              <span
                class:list={['about-tabs__icon', panel.icon]}
                aria-hidden="true"
              />
            )}
            {panel.title}
          </button>
        ))}
      </div>
      {IntroContent && (
        <div class="about-intro prose">
          <IntroContent />
        </div>
      )}
      {panels.map((panel, index) => (
        <div
          class="about-panel prose"
          role="tabpanel"
          id={panel.panelId}
          data-about-panel={panel.id}
          aria-labelledby={panel.tabId}
          hidden={index !== 0}
        >
          <panel.Content />
        </div>
      ))}
    </>
  )}
</section>

<script>
  import { placeSlidingIndicator } from '~/utils/sliding-indicator.js'

  const placeAboutIndicator = (animate: boolean) => {
    const list = document.querySelector<HTMLElement>('.about-tabs')
    if (!list) return
    const indicator = list.querySelector<HTMLElement>('.about-tabs__indicator')
    const current = list.querySelector<HTMLElement>('[aria-selected="true"]')
    placeSlidingIndicator({ indicator, target: current, animate })
    if (indicator?.dataset.ready === 'true') list.dataset.ready = 'true'
  }

  const tabsOf = () => [
    ...document.querySelectorAll<HTMLButtonElement>('[data-about-tab]'),
  ]

  const hashTabId = () => {
    try {
      return decodeURIComponent(location.hash.slice(1))
    } catch {
      // An invalid URL fragment falls back to the first tab.
      return ''
    }
  }

  const selectAboutTab = (id: string) => {
    const tabs = tabsOf()
    if (tabs.length === 0) return
    const exists = tabs.some((tab) => tab.dataset.aboutTab === id)
    const current = exists ? id : tabs[0].dataset.aboutTab
    if (!current) return

    tabs.forEach((tab) => {
      const on = tab.dataset.aboutTab === current
      tab.setAttribute('aria-selected', on ? 'true' : 'false')
      tab.tabIndex = on ? 0 : -1
    })
    document
      .querySelectorAll<HTMLElement>('[data-about-panel]')
      .forEach((panel) => {
        panel.hidden = panel.dataset.aboutPanel !== current
      })
    placeAboutIndicator(true)
    const nextHash = `#${encodeURIComponent(current)}`
    if (location.hash !== nextHash)
      history.replaceState(history.state, '', nextHash)
  }

  const setupAboutTabs = () => {
    const tabs = tabsOf()
    if (tabs.length === 0) return

    tabs.forEach((tab) => {
      if (tab.dataset.aboutBound) return
      tab.dataset.aboutBound = 'true'

      tab.addEventListener('click', () => {
        const id = tab.dataset.aboutTab
        if (id) selectAboutTab(id)
      })

      tab.addEventListener('keydown', (event) => {
        const index = tabs.indexOf(tab)
        let nextIndex: number | undefined
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length
        else if (event.key === 'ArrowLeft')
          nextIndex = (index - 1 + tabs.length) % tabs.length
        else if (event.key === 'Home') nextIndex = 0
        else if (event.key === 'End') nextIndex = tabs.length - 1
        if (nextIndex === undefined) return

        event.preventDefault()
        const nextTab = tabs[nextIndex]
        const id = nextTab.dataset.aboutTab
        nextTab.focus()
        if (id) selectAboutTab(id)
      })
    })

    selectAboutTab(hashTabId())
    document.fonts?.ready.then(() => placeAboutIndicator(false))
  }

  if (!document.documentElement.dataset.aboutIndicatorListeners) {
    document.documentElement.dataset.aboutIndicatorListeners = 'true'
    window.addEventListener('resize', () => placeAboutIndicator(false))
    // 同页面内只改片段时不会重新加载，也不会触发 astro:page-load。
    window.addEventListener('hashchange', () => selectAboutTab(hashTabId()))
  }

  document.addEventListener('astro:page-load', setupAboutTabs)
  setupAboutTabs()
</script>
