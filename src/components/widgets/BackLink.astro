---
import Link from '~/components/base/Link.astro'
import { ensureTrailingSlash, resolvePath, withBasePath } from '~/utils/path'

const currentPath = ensureTrailingSlash(Astro.url.pathname)
const isBlogDetail =
  currentPath.startsWith(resolvePath('/blogs')) &&
  currentPath !== resolvePath('/blogs')

const pathSegments = currentPath.split('/').slice(0, -2)
const href = isBlogDetail
  ? withBasePath('/blogs/')
  : pathSegments.length > 1
    ? pathSegments.join('/') + '/'
    : '/'
---

<span class="back-link__mark font-mono" aria-hidden="true">
  &gt;{' '}
</span>
<Link class="font-mono op-50!" {href}>
  cd ..
</Link>

<style>
  .back-link__mark {
    color: var(--accent);
  }
</style>
