---
import SearchSwitch from '~/components/widgets/SearchSwitch.astro'
import ThemeSwitch from '~/components/widgets/ThemeSwitch.astro'
import NavItem from './NavItem.astro'
import Divider from '~/components/base/Divider.astro'
import { UI } from '~/config'
import { withBasePath } from '~/utils/path'
const { internalNavs, socialLinks, navBarLayout } = UI
const home = withBasePath('/')
---

<header class="nav-bar" data-site-header>
  <nav aria-label="主导航" class="nav-bar__inner">
    {(['left', 'right'] as const).map((side) => (
      <div class={`nav-bar__group nav-bar__group--${side}`}>
        {side === 'left' && (
          <a class="nav-bar__brand" href={home}>
            WutongRain's Blog
          </a>
        )}
        {navBarLayout[side].map((key) =>
          key === 'internalNavs' ? (
            <div class="nav-bar__pages" transition:persist="nav-pages">
              <span class="nav-bar__indicator" aria-hidden="true" />
              {internalNavs.map((item) => (
                <NavItem type="internal" {item} />
              ))}
            </div>
          ) : key === 'socialLinks' ? (
            <div class="nav-bar__social">
              {socialLinks.map((item) => (
                <NavItem type="social" {item} />
              ))}
            </div>
          ) : key === 'searchButton' ? (
            <SearchSwitch />
          ) : key === 'themeButton' ? (
            <ThemeSwitch />
          ) : (
            <Divider />
          )
        )}
      </div>
    ))}
  </nav>
</header>
<script>
  import { placeSlidingIndicator } from '~/utils/sliding-indicator.js'

  const normalize = (pathname: string) =>
    pathname.endsWith('/') ? pathname : `${pathname}/`

  const pages = () => document.querySelector<HTMLElement>('.nav-bar__pages')

  const linksOf = (nav: HTMLElement) =>
    Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'))

  const linkPath = (link: HTMLAnchorElement) =>
    normalize(new URL(link.href).pathname)

  const homePath = () => {
    const brand = document.querySelector<HTMLAnchorElement>('a.nav-bar__brand')
    return brand ? linkPath(brand) : '/'
  }

  const currentLink = (nav: HTMLElement) => {
    const path = normalize(location.pathname)
    const home = homePath()
    return (
      linksOf(nav).find((link) => {
        const target = linkPath(link)
        return (
          target === path ||
          (target === home && path.startsWith(`${home}blogs/`))
        )
      }) ?? null
    )
  }

  /**
   * The pill paints an opaque background, so the link under it has to flip its own
   * color. That pairing is a visual fact, not a navigation fact: `aria-current`
   * keeps naming the page the user is actually on, while `data-nav-current` names
   * the item the pill is drawn on — which leads the page during a preview.
   */
  const markCurrent = (nav: HTMLElement, current: HTMLAnchorElement | null) => {
    linksOf(nav).forEach((link) => {
      if (link === current) link.setAttribute('aria-current', 'page')
      else link.removeAttribute('aria-current')
    })
  }

  const markIndicatorTarget = (
    nav: HTMLElement,
    target: HTMLAnchorElement | null
  ) => {
    linksOf(nav).forEach((link) => {
      if (link === target) link.setAttribute('data-nav-current', '')
      else link.removeAttribute('data-nav-current')
    })
  }

  let pendingLink: HTMLAnchorElement | null = null
  /** Pathname when the preview started, to tell a landed load from a stale one. */
  let pendingFrom: string | null = null

  const placeIndicator = (animate: boolean) => {
    const nav = pages()
    if (!nav) return
    const indicator = nav.querySelector<HTMLElement>('.nav-bar__indicator')
    const current = currentLink(nav)
    const target = pendingLink?.isConnected ? pendingLink : current
    markCurrent(nav, current)
    markIndicatorTarget(nav, target)
    placeSlidingIndicator({ indicator, target, animate })
  }

  const start = () => {
    const nav = pages()
    if (!nav || nav.dataset.indicatorBound === 'true') return
    nav.dataset.indicatorBound = 'true'
    placeIndicator(false)
    document.fonts?.ready.then(() => placeIndicator(Boolean(pendingLink)))
  }

  if (!document.documentElement.dataset.navIndicatorListeners) {
    document.documentElement.dataset.navIndicatorListeners = 'true'
    // Astro only emits this for navigations it actually intercepts (not new tabs,
    // modified clicks, downloads or external links). The old page stays readable.
    document.addEventListener('astro:before-preparation', (event) => {
      const nav = pages()
      const source = event.sourceElement
      if (!(source instanceof HTMLAnchorElement) || !nav) return
      const link = nav.contains(source)
        ? source
        : source.matches('a.nav-bar__brand')
          ? linksOf(nav).find((item) => linkPath(item) === linkPath(source))
          : null
      if (!link || link === currentLink(nav)) return

      pendingLink = link
      pendingFrom = normalize(location.pathname)
      placeIndicator(true)
      const rollback = () => {
        if (pendingLink !== link) return
        pendingLink = null
        pendingFrom = null
        placeIndicator(true)
      }
      event.signal.addEventListener('abort', rollback, { once: true })
      queueMicrotask(() => {
        if (event.defaultPrevented || event.signal.aborted) rollback()
      })
    })
    document.addEventListener('astro:page-load', () => {
      // Astro also fires this from window load and from a previous navigation's
      // completion. Those are not this navigation landing, so keep the preview
      // instead of snapping the pill back to the page the user is leaving.
      if (pendingLink && normalize(location.pathname) === pendingFrom) {
        placeIndicator(true)
        return
      }
      pendingLink = null
      pendingFrom = null
      placeIndicator(true)
    })
    window.addEventListener('resize', () =>
      placeIndicator(Boolean(pendingLink))
    )
  }
  start()
</script>
