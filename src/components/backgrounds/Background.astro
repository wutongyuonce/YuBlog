---
import Dot from '~/components/backgrounds/Dot.astro'
import Rose from '~/components/backgrounds/Rose.astro'
import Snow from '~/components/backgrounds/Snow.astro'

interface Props {
  type: string
}

const { type } = Astro.props
---

{type === 'dot' && <Dot />}
{type === 'rose' && <Rose />}
{type === 'snow' && <Snow />}
